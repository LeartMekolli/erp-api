// Prisma 7: the datasource carries no connection URL. Migrate reads its URL
// from prisma.config.ts, and the client is constructed with a driver adapter.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The project is CommonJS (no "type": "module"), and ts-jest compiles to CJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  // uuid(7) is generated by Prisma Client, not the database, so ids stay
  // application-generated and time-ordered as ADR 0004 requires.
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  status          String   @default("active")
  defaultCurrency String   @map("default_currency") @db.Char(3)
  defaultLocale   String   @map("default_locale")
  timezone        String
  // The workspace's customer site, such as https://shop.example: customer emails link there and
  // it may call the API (Customers spec, goal 13). Platform-level, so CORS can read it per request.
  customerSiteOrigin String? @map("customer_site_origin")
  // What the workspace's staff AI may cost per UTC month, in USD, set by a platform admin (AI spec).
  // Null: no AI.
  aiMonthlyLimitUsd Decimal? @map("ai_monthly_limit_usd") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  settings        TenantSetting[]
  users           User[]
  roles           Role[]
  serviceAccounts ServiceAccount[]
  idempotencyKeys IdempotencyKey[]
  notifications   Notification[]
  notificationTemplates NotificationTemplate[]
  files           File[]
  units           Unit[]
  materials       Material[]
  optionGroups    OptionGroup[]
  optionValues    OptionValue[]
  optionRules     OptionRule[]
  optionRuleTargets OptionRuleTarget[]
  categories      Category[]
  products        Product[]
  productOptionGroups ProductOptionGroup[]
  productOptionValues ProductOptionValue[]
  assemblyParts   AssemblyPart[]
  stepTypes       StepType[]
  pricingProfile  PricingProfile?
  categorySteps   CategoryStep[]
  productChains   ProductChain[]
  productSteps    ProductStep[]
  optionStepEffects OptionStepEffect[]
  stepPrices      StepPrice[]
  marginOverrides MarginOverride[]
  discountTiers   DiscountTier[]
  customerGroups  CustomerGroup[]
  deliverySpeeds  DeliverySpeed[]
  minSizeSurcharges MinSizeSurcharge[]
  quotes          Quote[]
  customers       Customer[]
  customerInvitations CustomerInvitation[]
  defects         Defect[]
  workflows       Workflow[]
  workflowVersions WorkflowVersion[]
  workflowSteps   WorkflowStep[]
  workOrderGroups WorkOrderGroup[]
  workOrders      WorkOrder[]
  transitions     Transition[]
  transitionAnswers TransitionAnswer[]
  transitionPhotos TransitionPhoto[]
  partners        Partner[]
  partnerInvitations PartnerInvitation[]
  partnerCapabilities PartnerCapability[]
  partnerClosedPeriods PartnerClosedPeriod[]
  partnerOfferings PartnerOffering[]
  partnerStepPrices PartnerStepPrice[]
  jobAssignments  JobAssignment[]
  jobRatings      JobRating[]
  partnerCapacitySnapshots PartnerCapacitySnapshot[]
  shippingMethods ShippingMethod[]
  taxRates        TaxRate[]
  orders          Order[]
  orderLines      OrderLine[]
  orderComments   OrderComment[]
  orderLineParts  OrderLinePart[]
  orderCounter    OrderCounter?
  paymentAccount  PaymentAccount?
  ledgerJournals  LedgerJournal[]
  paymentEvents   PaymentEvent[]
  customerPaymentTerms CustomerPaymentTerms[]
  orderPayments   OrderPayment[]
  invoices        Invoice[]
  refunds         Refund[]
  partnerPayoutAccounts PartnerPayoutAccount[]
  payouts         Payout[]
  payoutJobs      PayoutJob[]
  plans           Plan[]
  planPrices      PlanPrice[]
  planSpeeds      PlanSpeed[]
  creditGrants    CreditGrant[]
  creditSpends    CreditSpend[]
  creditEntries   CreditEntry[]
  customerSubscriptions CustomerSubscription[]
  subscriptionNotices   SubscriptionNotice[]
  subscriptionPaidPeriods SubscriptionPaidPeriod[]
  creditPacks           CreditPack[]
  creditPackPurchases   CreditPackPurchase[]
  creditCampaigns       CreditCampaign[]
  creditCampaignTargets CreditCampaignTarget[]
  aiRuns                AiRun[]
  aiRunResults          AiRunResult[]
  aiLimitNotices        AiLimitNotice[]
  reportWeeks           ReportWeek[]
  knowledgeArticles     KnowledgeArticle[]
  knowledgeAttachments  KnowledgeAttachment[]
  aiBriefings           AiBriefing[]
  aiSuggestions         AiSuggestion[]
  aiSuggestionDismissals AiSuggestionDismissal[]
  aiCustomerResults     AiCustomerResult[]
  aiBrandProfiles       AiBrandProfile[]
  reportExports         ReportExport[]
  skills                Skill[]
  userSkills            UserSkill[]
  sampleDraws           SampleDraw[]
  samplePieces          SamplePiece[]
  orderProgressEmails   OrderProgressEmail[]
  customerPriorities    CustomerPriority[]
  claims                Claim[]
  creditNotes           CreditNote[]
  jobSummaries          JobSummary[]
  stepCapacities        StepCapacity[]
  courierAccount        CourierAccount?
  shipments             Shipment[]
  courierEvents         CourierEvent[]

  @@map("tenant")
}

// ---------------------------------------------------------------------------
// Identity (spec section 4). Every model below except PlatformAdmin is
// tenant-owned and follows src/database/rls.sql.md. Child tables reach the
// tenant through a composite foreign key (tenant_id, x_id) -> (tenant_id, id):
// foreign-key checks bypass row-level security, so a plain key would accept
// another tenant's id. Emails are stored trimmed and lowercased.
// ---------------------------------------------------------------------------

/// Platform-owned: acts across tenants through platform endpoints (ADR 0001).
model PlatformAdmin {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens PlatformRefreshToken[]

  @@map("platform_admin")
}

// A platform admin's rotating refresh tokens. No tenant: platform admins act across them. A session
// (one family) ends a fixed time after login; rotating never lengthens it.
model PlatformRefreshToken {
  id              String    @id @default(uuid(7)) @db.Uuid
  platformAdminId String    @map("platform_admin_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  familyId        String    @map("family_id") @db.Uuid
  rotatedFromId   String?   @map("rotated_from_id") @db.Uuid
  issuedAt        DateTime  @default(now()) @map("issued_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  // rotated | reuse_detected | logout
  revokedReason   String?   @map("revoked_reason")

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([platformAdminId])
  @@map("platform_refresh_token")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  status       String   @default("active")
  locale       String
  // staff | customer | partner: customer and partner people hold memberships of their own kind, never workspace roles
  kind         String   @default("staff")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  memberships    OrganisationMembership[]
  notifications  NotificationRecipient[]
  files          File[]
  fileVersions   FileVersion[]
  externalIdentities ExternalIdentity[]
  transitions    Transition[]
  orderComments  OrderComment[]
  ledgerJournals LedgerJournal[]
  releasedOrders Order[]
  refunds        Refund[]
  payouts        Payout[]
  creditGrants   CreditGrant[]
  creditPackPurchases CreditPackPurchase[]
  creditCampaigns     CreditCampaign[]
  aiRuns              AiRun[]
  knowledgeArticles   KnowledgeArticle[]
  aiSuggestionDismissals AiSuggestionDismissal[]
  aiCustomerResults      AiCustomerResult[] @relation("ai_customer_result_created_by")
  aiCustomerResultsDeleted AiCustomerResult[] @relation("ai_customer_result_deleted_by")
  aiBrandProfiles        AiBrandProfile[]
  reportExports          ReportExport[]
  skills                 UserSkill[] @relation("user_skill_holder")
  skillsGranted          UserSkill[] @relation("user_skill_granted_by")
  priorityOverrides      CustomerPriority[]
  claimsOpened           Claim[]
  claimLinesDecided      ClaimLine[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@map("app_user")
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  invitations Invitation[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("role")
}

model RolePermission {
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permission")
}

model UserRole {
  tenantId String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// A skill a step may require, such as "Casting" (Workflow 2 spec, goal 9): the workspace's own list.
// Names are unique per workspace regardless of case (a unique index on lower(name), in the migration).
model Skill {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name       String
  // Archived skills can't be given or required; staff who hold one keep the row.
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserSkill[]

  @@unique([tenantId, id])
  @@map("skill")
}

// A skill a staff member holds (goal 10). An expired one counts as not held.
model UserSkill {
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  skillId         String    @map("skill_id") @db.Uuid
  // The last day the skill is held; null: never expires.
  expiresOn       DateTime? @map("expires_on") @db.Date
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("user_skill_holder", fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  skill     Skill  @relation(fields: [tenantId, skillId], references: [tenantId, id], onDelete: Cascade)
  grantedBy User   @relation("user_skill_granted_by", fields: [tenantId, grantedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, userId, skillId])
  @@index([tenantId, skillId])
  @@index([tenantId, grantedByUserId])
  @@map("user_skill")
}

/// One row per issued refresh token; a family is one login's rotation chain (F2, F3).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  issuedAt      DateTime  @default(now()) @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  // rotated | reuse_detected | logout | password_reset
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token")
}

model Invitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  // Null when a platform admin invited the tenant's owner.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitation")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset")
}

/// A user's membership in a partner or customer organisation (D44, D56). The
/// organisation tables arrive with their modules; organisation_id gets its
/// foreign key then.
model OrganisationMembership {
  id               String @id @default(uuid(7)) @db.Uuid
  tenantId         String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId           String @map("user_id") @db.Uuid
  // partner | customer
  organisationType String @map("organisation_type")
  organisationId   String @map("organisation_id") @db.Uuid
  role             String

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([userId, organisationType, organisationId])
  @@map("organisation_membership")
}

/// A sign-in account at an outside provider, linked to a user by the
/// provider's stable subject id, never by email (Customers spec, goal 4).
model ExternalIdentity {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // google
  provider  String
  subject   String
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, subject])
  @@index([tenantId, userId])
  @@map("external_identity")
}

/// Modelled now; keys are issued with order intake (Q7).
model ServiceAccount {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name      String
  keyHash   String   @unique @map("key_hash")
  scopes    String[]
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("service_account")
}

/// Append-only (ADR 0003, F8). No foreign keys, deliberately: entries outlive
/// the rows they describe, the tenant included, and a cascading delete would be
/// refused by the append-only trigger anyway.
model AuditEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // user | platform_admin | system
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id") @db.Uuid
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_entry")
}

model TenantSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  // Filled from the transaction's tenant (PrismaService.inTenant), so callers
  // never pass it. Every tenant-owned table carries this default.
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

// ---------------------------------------------------------------------------
// Jobs and idempotency (spec section 7, ADR 0005).
// ---------------------------------------------------------------------------

/// A client's Idempotency-Key on a tenant POST, with the response it got, so
/// a retry replays it instead of acting twice. Deleted after 30 days.
model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key            String
  // sha256 of user, method, path and canonical body
  fingerprint    String    @db.Char(64)
  // in_progress | completed
  status         String
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------
// Notifications (spec section 6). Domain code raises a notification; the
// worker fans it out to the in-app feed and to email, one delivery row per
// attempt.
// ---------------------------------------------------------------------------

/// One raised event. `payload` holds the template variables except secrets,
/// which are sealed in `secrets` and wiped once sent (plan N2). Claimed by the
/// dispatch job: pending -> dispatching -> dispatched, or failed.
model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  eventKey    String    @map("event_key")
  // invitee | user | permission
  audience    String
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id") @db.Uuid
  payload     Json
  secrets     Bytes?
  status      String
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("notification")
}

/// The in-app feed: one row per user a notification reached, with the title
/// and body rendered at dispatch (plan N6).
model NotificationRecipient {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)
  user         User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([tenantId, userId, id])
  @@map("notification_recipient")
}

/// A tenant's override of a repo template (D69). Repo templates stay the
/// defaults; `enabled: false` falls back to them.
model NotificationTemplate {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  eventKey        String   @map("event_key")
  locale          String
  subject         String
  body            String
  enabled         Boolean  @default(true)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventKey, locale])
  @@map("notification_template")
}

/// Append-only (ADR 0003): one row per delivery attempt. No foreign keys, as
/// with audit_entry: the log outlives what it describes.
model NotificationDelivery {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  // email
  channel        String
  target         String
  // sent | failed
  status         String
  attempt        Int
  providerId     String?  @map("provider_id")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, notificationId])
  @@map("notification_delivery")
}

// ---------------------------------------------------------------------------
// Files (spec section 5). Bytes live in private object storage under
// <tenant_id>/<file_id>/<version_id>; these tables hold what is known about
// them. Who created or uploaded a file is a real user of the same tenant: the
// uploader is notified when measurement finishes. Those two keys are
// DEFERRABLE INITIALLY DEFERRED in the migration (Prisma cannot express it), so
// a tenant delete can remove users and files in the same transaction.
// ---------------------------------------------------------------------------

model File {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // design | image | document | other
  kind            String
  name            String
  // mm | cm | m | in; meshes carry none (Q4)
  declaredUnit    String?  @map("declared_unit")
  // Set by the module that attaches the file; none ships with the foundation.
  ownerType       String?  @map("owner_type")
  ownerId         String?  @map("owner_id") @db.Uuid
  // active | removed (its bytes deleted; not found by any route)
  status          String   @default("active")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  versions  FileVersion[]
  knowledgeAttachments KnowledgeAttachment[]
  aiCustomerResults    AiCustomerResult[]
  reportExports        ReportExport[]

  @@unique([tenantId, id])
  @@index([tenantId, ownerType, ownerId])
  @@map("file")
}

/// One uploaded version. Claimed by the measurement job (rule A1):
/// pending -> completing -> uploaded -> measuring -> measured, or failed after
/// the last attempt. `completing` is the claim held while an upload is copied
/// to its final key.
model FileVersion {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  fileId           String    @map("file_id") @db.Uuid
  number           Int
  storageKey       String    @unique @map("storage_key")
  // Used only for the download's Content-Disposition, never in a storage key.
  originalName     String    @map("original_name")
  contentType      String    @map("content_type")
  size             BigInt
  // SHA-256 in hex, computed by the measurement job.
  checksum         String?   @db.Char(64)
  status           String    @default("pending")
  claimedAt        DateTime? @map("claimed_at")
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  file       File      @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [tenantId, uploadedByUserId], references: [tenantId, id], onDelete: NoAction)
  measures   Measure[]
  products   Product[]
  sopForSteps WorkflowStep[]
  workOrderGroups WorkOrderGroup[]
  transitionPhotos TransitionPhoto[]
  partnerAgreements Partner[]
  commentAttachments OrderCommentAttachment[]
  claimPhotos        ClaimPhoto[]

  @@unique([fileId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("file_version")
}

/// What a measurer found in a version (D60, Q4): one value per measure type.
model Measure {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  fileVersionId String  @map("file_version_id") @db.Uuid
  type          String
  value         Decimal @db.Decimal(18, 6)
  unit          String

  version FileVersion @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([fileVersionId, type])
  @@index([tenantId])
  @@map("measure")
}

// Catalog (spec 2026-10-22). Seeded units live in code (units.ts); a tenant's own are here.
model Unit {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  // mass | volume | area | length | count
  dimension String
  // Base units of the dimension per one of this unit.
  factor    Decimal  @db.Decimal(18, 9)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("unit")
}

// A material a step consumes, with its price source (Catalog spec C5, B6, B7).
model Material {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key              String
  name             String
  // A unit key (seeded or the tenant's) of dimension mass, volume or count.
  pricedUnit       String    @map("priced_unit")
  densityGCm3      Decimal?  @map("density_g_cm3") @db.Decimal(18, 6)
  // feed | manual
  priceSource      String    @map("price_source")
  // The price provider's metal key, such as silver.
  feedMetal        String?   @map("feed_metal")
  addonPercent     Decimal   @default(0) @map("addon_percent") @db.Decimal(9, 4)
  addonAmount      Decimal   @default(0) @map("addon_amount") @db.Decimal(18, 6)
  manualPrice      Decimal?  @map("manual_price") @db.Decimal(18, 6)
  fallbackPrice    Decimal?  @map("fallback_price") @db.Decimal(18, 6)
  // Every price above, and the override, is in this currency.
  currency         String    @db.Char(3)
  overridePrice    Decimal?  @map("override_price") @db.Decimal(18, 6)
  overrideReason   String?   @map("override_reason")
  overrideAt       DateTime? @map("override_at")
  overrideByUserId String?   @map("override_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionValues OptionValue[]
  products     Product[]
  stepPrices   StepPrice[]
  partnerPrices PartnerStepPrice[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("material")
}

// Daily metal prices from the price provider (Catalog spec C5, D87). Platform
// data, not tenant-owned: one fetch per currency serves every tenant.
model MetalPriceSnapshot {
  id           String   @id @default(uuid(7)) @db.Uuid
  provider     String
  metal        String
  currency     String   @db.Char(3)
  pricePerGram Decimal  @map("price_per_gram") @db.Decimal(18, 9)
  fetchedAt    DateTime @map("fetched_at")

  @@index([metal, currency, fetchedAt(sort: Desc)])
  @@map("metal_price_snapshot")
}

// A configurable dimension of a product, such as material or finish (Catalog spec C4).
model OptionGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values        OptionValue[]
  productGroups ProductOptionGroup[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("option_group")
}

// One choice within a group. Choosing it may select a material (the catalog's option effect).
model OptionValue {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  key        String
  name       String
  materialId String?  @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       OptionGroup        @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  material    Material?          @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction)
  rules       OptionRule[]
  ruleTargets OptionRuleTarget[]
  productDefaults ProductOptionGroup[]
  productOffers   ProductOptionValue[]
  stepEffects     OptionStepEffect[]
  partnerOfferings PartnerOffering[]

  @@unique([groupId, key])
  @@unique([tenantId, id])
  @@map("option_value")
}

// excludes: choosing the value rules out every target. requires: it needs at least one target (spec C4, B9).
model OptionRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // excludes | requires
  kind      String
  valueId   String   @map("value_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value   OptionValue        @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)
  targets OptionRuleTarget[]

  @@unique([tenantId, id])
  @@index([tenantId, valueId])
  @@map("option_rule")
}

model OptionRuleTarget {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  ruleId   String @map("rule_id") @db.Uuid
  valueId  String @map("value_id") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   OptionRule  @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Cascade)
  value  OptionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([ruleId, valueId])
  @@index([tenantId])
  @@map("option_rule_target")
}

// Groups products and names the measures a design file must have (Catalog spec, B1).
model Category {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key              String
  name             String
  // A subset of MEASURE_TYPES in src/modules/files/measurers.ts.
  requiredMeasures String[] @map("required_measures")
  // The workflow its products go through, unless a product has its own (D33).
  workflowId       String?  @map("workflow_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow?      @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: NoAction)
  products Product[]
  steps    CategoryStep[]
  margin   MarginOverride?
  minSizeSurcharges MinSizeSurcharge[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("category")
}

// custom: the customer brings the design file; ready_made: the product pins its own measured version (C2, B1).
model Product {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  key           String
  name          String
  // custom | ready_made
  kind          String
  fileVersionId String?  @map("file_version_id") @db.Uuid
  // A material the product fixes, instead of one chosen through an option (B11).
  materialId    String?  @map("material_id") @db.Uuid
  // { mode: none } | { mode: range, min, max } | { mode: named, sizes: [{ key, scale }] }, scales as decimal strings (C3).
  sizing        Json
  // active
  status        String   @default("active")
  // Customers see a product only once staff publish it (Customers spec, goal 11).
  published     Boolean  @default(false)
  // Set for a customer's private product; null for the shared catalog (goal 7).
  customerId    String?  @map("customer_id") @db.Uuid
  // Replaces its category's workflow when set (D33).
  workflowId    String?  @map("workflow_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category             @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction)
  workflow     Workflow?            @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: NoAction)
  customer     Customer?            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  fileVersion  FileVersion?         @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)
  material     Material?            @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction)
  optionGroups ProductOptionGroup[]
  optionValues ProductOptionValue[]
  chain        ProductChain?
  quotes       Quote[]
  workOrderGroups WorkOrderGroup[]
  orderLines   OrderLine[]
  orderLineParts OrderLinePart[]
  steps        ProductStep[]
  margin       MarginOverride?
  // An assembly's parts, and the assemblies a product is a part of (Orders spec, goal 6).
  parts        AssemblyPart[] @relation("AssemblyParts")
  partOf       AssemblyPart[] @relation("PartOf")

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("product")
}

// A ready-made product an assembly is made of, how many per assembly, and the size it is made at
// (Orders spec, goal 6; B6). One level only: a part is never an assembly.
model AssemblyPart {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  assemblyId String @map("assembly_id") @db.Uuid
  partId     String @map("part_id") @db.Uuid
  position   Int
  quantity   Int
  // { scale } | { named }; null: the part as it is.
  size       Json?

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assembly Product @relation("AssemblyParts", fields: [tenantId, assemblyId], references: [tenantId, id], onDelete: Cascade)
  // A part in use is kept: deleting it would silently change what the assembly is made of.
  part     Product @relation("PartOf", fields: [tenantId, partId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, assemblyId, partId])
  @@index([tenantId])
  @@map("assembly_part")
}

// An option group a product offers, whether it must be answered, and its default (C4, B10).
model ProductOptionGroup {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  groupId        String  @map("group_id") @db.Uuid
  required       Boolean
  defaultValueId String? @map("default_value_id") @db.Uuid
  position       Int

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  group        OptionGroup  @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  defaultValue OptionValue? @relation(fields: [tenantId, defaultValueId], references: [tenantId, id], onDelete: NoAction)

  @@unique([productId, groupId])
  @@index([tenantId])
  @@map("product_option_group")
}

// An option value a product allows.
model ProductOptionValue {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  valueId   String @map("value_id") @db.Uuid

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  value   OptionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([productId, valueId])
  @@index([tenantId])
  @@map("product_option_value")
}

// A kind of production operation, as workspace configuration (Pricing spec). The summary group
// places its cost in the customer summary: material | making | finishing.
model StepType {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key          String
  name         String
  // Orders the steps of a chain.
  position     Int
  // material | making | finishing; null for a step nobody prices (final QC, packing), never in a chain or priced.
  summaryGroup String?  @map("summary_group")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categorySteps CategoryStep[]
  productSteps  ProductStep[]
  optionEffects OptionStepEffect[]
  prices        StepPrice[]
  workflowSteps WorkflowStep[]
  partnerCapabilities PartnerCapability[]
  partnerPrices PartnerStepPrice[]
  capacitySnapshots PartnerCapacitySnapshot[]
  capacity      StepCapacity?

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("step_type")
}

// The workspace's pricing defaults; absent until first set, and read as the defaults below.
model PricingProfile {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @unique @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  marginPercent    Decimal  @default(0) @map("margin_percent") @db.Decimal(9, 4)
  overheadPerPiece Decimal  @default(0) @map("overhead_per_piece") @db.Decimal(18, 6)
  // How long a quote holds its price, in hours (Orders spec, goal 2).
  quoteValidHours  Int      @default(4) @map("quote_valid_hours")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pricing_profile")
}

// The usual chain of steps for a category's products (Pricing spec R4).
model CategoryStep {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  stepTypeId String @map("step_type_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([categoryId, stepTypeId])
  @@index([tenantId])
  @@map("category_step")
}

// Present when a product replaces its category's chain with its own (which may be empty).
model ProductChain {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId String @unique @map("product_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  // One-to-one through the tenant-scoped key needs it unique; `product_id` alone stays unique for upserts.
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@map("product_chain")
}

model ProductStep {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  stepTypeId String @map("step_type_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([productId, stepTypeId])
  @@index([tenantId])
  @@map("product_step")
}

// Choosing the value adds or removes the step (the option effect on steps, Pricing spec R4).
model OptionStepEffect {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  valueId    String @map("value_id") @db.Uuid
  stepTypeId String @map("step_type_id") @db.Uuid
  // add | remove
  effect     String

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value    OptionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType    @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([valueId, stepTypeId])
  @@index([tenantId])
  @@map("option_step_effect")
}

// What a step costs, from typed building blocks (Pricing spec, Q2). With a material, the price for
// that material only; without, the step's default. Saves lock the step type, so a step has at most
// one default even though Postgres treats the null material_id as distinct.
model StepPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  materialId     String?  @map("material_id") @db.Uuid
  failurePercent Decimal  @map("failure_percent") @db.Decimal(9, 4)
  // Validated by blocksSchema (src/modules/pricing/blocks.ts) on every save.
  blocks         Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stepType StepType  @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)
  material Material? @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, stepTypeId, materialId])
  @@index([tenantId])
  @@map("step_price")
}

// A category's or a product's own margin instead of the pricing profile's (Pricing spec, Q5).
// Exactly one of category_id and product_id is set (a CHECK in the migration).
model MarginOverride {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId    String?  @unique @map("category_id") @db.Uuid
  productId     String?  @unique @map("product_id") @db.Uuid
  marginPercent Decimal  @map("margin_percent") @db.Decimal(9, 4)
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  product  Product?  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, categoryId])
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@map("margin_override")
}

// From `min_quantity` pieces on, `percent` off; the highest tier reached applies (P6).
model DiscountTier {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  minQuantity Int     @map("min_quantity")
  percent     Decimal @db.Decimal(9, 4)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, minQuantity])
  @@index([tenantId])
  @@map("discount_tier")
}

// A markup (positive) or discount (negative) for a group of customers (D45).
model CustomerGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  percent   Decimal  @db.Decimal(9, 4)
  createdAt DateTime @default(now()) @map("created_at")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers       Customer[]
  orders          Order[]
  campaignTargets CreditCampaignTarget[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("customer_group")
}

// Standard, express, rush...: a surcharge on the price (Q11). Saves take a per-tenant advisory
// lock, so at most one speed is the default.
model DeliverySpeed {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key              String
  name             String
  surchargePercent Decimal  @map("surcharge_percent") @db.Decimal(9, 4)
  isDefault        Boolean  @default(false) @map("is_default")
  // Working days from placing an order to its promised date (Orders spec, goal 7).
  workingDays      Int      @default(0) @map("working_days")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planSpeeds PlanSpeed[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("delivery_speed")
}

// A fixed amount per piece when a measure of the scaled design is below `below` `unit` (P7).
// Without a category it applies to every category.
model MinSizeSurcharge {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  measure    String
  below      Decimal  @db.Decimal(18, 6)
  // A catalog unit key of the measure's dimension.
  unit       String
  amount     Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@map("min_size_surcharge")
}

// A saved price for a configuration, held until it expires (Pricing spec). Everything is copied in,
// never re-read: later price changes do not move it.
model Quote {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int
  currency        String   @db.Char(3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)
  // Options, size, file version, customer group and delivery speed as requested and resolved.
  inputs          Json
  // Every material priced, with its price, source and staleness at quote time.
  materials       Json
  breakdown       Json
  summary         Json
  expiresAt       DateTime @map("expires_at")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  // The customer the quote is for, which sees it in the portal; null for an internal quote.
  customerId      String?  @map("customer_id") @db.Uuid
  // The workshop the customer picked, whose prices the quote used on its steps, and what it is paid
  // for the job (Partners spec, goal 12). Both null for a quote at the workspace's own prices.
  partnerId       String?  @map("partner_id") @db.Uuid
  partnerCost     Decimal? @map("partner_cost") @db.Decimal(18, 2)
  // A part's quote within an assembly's, and the part's position; both null for any other quote
  // (Orders spec, goal 6). Only the assembly's quote is listed, read by customers and ordered.
  parentQuoteId   String?  @map("parent_quote_id") @db.Uuid
  position        Int?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // A quoted product is kept: a saved quote outlives changes to the catalog.
  product  Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction)
  parent   Quote?    @relation("QuoteParts", fields: [tenantId, parentQuoteId], references: [tenantId, id], onDelete: Cascade)
  parts    Quote[]   @relation("QuoteParts")
  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  partner  Partner?  @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  workOrderGroups WorkOrderGroup[]
  orderLine       OrderLine?
  orderLinePart   OrderLinePart?

  // For tenant-scoped foreign keys to a quote (work order groups, order lines).
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, partnerId])
  @@index([tenantId, parentQuoteId])
  @@map("quote")
}

// A customer organisation: a brand, or one person on their own (Customers spec, D44).
model Customer {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name            String
  // active | disabled: a disabled customer's people cannot act for it
  status          String   @default("active")
  customerGroupId String?  @map("customer_group_id") @db.Uuid
  // The customer's people may pick the workshop for a quote (Partners spec, goal 12).
  mayPickPartner  Boolean  @default(false) @map("may_pick_partner")
  // Validated by addressSchema (Customers 2 spec, goals 6–7): orders start from the shipping address;
  // invoices carry the billing address, else the shipping one, and the VAT number.
  shippingAddress Json?    @map("shipping_address")
  billingAddress  Json?    @map("billing_address")
  vatNumber       String?  @map("vat_number")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup?       @relation(fields: [tenantId, customerGroupId], references: [tenantId, id], onDelete: NoAction)
  invitations   CustomerInvitation[]
  products      Product[]
  quotes        Quote[]
  workOrderGroups WorkOrderGroup[]
  jobRatings    JobRating[]
  orders        Order[]
  ledgerJournals LedgerJournal[]
  ledgerLines   LedgerLine[]
  paymentTerms  CustomerPaymentTerms?
  creditGrants  CreditGrant[]
  creditSpends  CreditSpend[]
  creditEntries CreditEntry[]
  subscription  CustomerSubscription?
  subscriptionNotices SubscriptionNotice[]
  subscriptionPaidPeriods SubscriptionPaidPeriod[]
  creditPackPurchases CreditPackPurchase[]
  campaignTargets     CreditCampaignTarget[]
  aiResults           AiCustomerResult[]
  aiBrandProfile      AiBrandProfile?
  priority            CustomerPriority?

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("customer")
}

// An invitation to act for a customer with a role. Accepting creates the customer person, or adds a
// membership when the email already belongs to one (Customers spec, goals 2–3).
model CustomerInvitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  // Lowercased.
  email           String
  // owner | admin | buyer | viewer
  role            String
  tokenHash       String    @unique @map("token_hash")
  // A staff user or a customer person; null when seeded.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId, email])
  @@map("customer_invitation")
}

// ---------------------------------------------------------------------------
// Workflow/QC (docs/superpowers/specs/2026-10-23-workflow-qc-design.md).
// ---------------------------------------------------------------------------

// A catalogued failure reason recorded on a transition (D38). Never deleted, since transitions
// point at it; an inactive defect can't be added to a workflow step.
model Defect {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transitions Transition[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("defect")
}

// An ordered list of checked steps, assigned on a category and overridable per product (D33).
model Workflow {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions   WorkflowVersion[]
  categories Category[]
  products   Product[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("workflow")
}

// One immutable version of a workflow's steps (D34). Editing the steps adds the next number; the
// latest is the current one.
model WorkflowVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  workflowId      String   @map("workflow_id") @db.Uuid
  number          Int
  // Null when seeded.
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  // The partner step whose pass makes the partner owed; null means the last partner step
  // (src/modules/workflow/partner-steps.ts).
  payoutStepId    String?  @map("payout_step_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow   Workflow       @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  steps      WorkflowStep[] @relation("VersionSteps")
  payoutStep WorkflowStep?  @relation("VersionPayoutStep", fields: [tenantId, payoutStepId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  groups     WorkOrderGroup[]

  @@unique([tenantId, workflowId, number])
  @@unique([tenantId, id])
  @@map("workflow_version")
}

// A step of one workflow version, never changed. `config` holds the checklist, defects, rework
// targets, photo and comment rules and the customer view (src/modules/workflow/workflow-config.ts).
model WorkflowStep {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  versionId        String   @map("version_id") @db.Uuid
  // From 0, in the order pieces go through the steps.
  position         Int
  key              String
  name             String
  stepTypeId       String   @map("step_type_id") @db.Uuid
  // Whether the step type was priced when this version was made. Paths read this, never the step type,
  // so changing a step type later can't reroute pieces already running on the version.
  priced           Boolean
  // partner | workspace: a partner's step, or one the workspace does in-house (Partners spec, goal 7)
  doneBy           String   @default("partner") @map("done_by")
  config           Json
  sopFileVersionId String?  @map("sop_file_version_id") @db.Uuid
  expectedMinutes  Decimal? @map("expected_minutes") @db.Decimal(9, 2)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version        WorkflowVersion @relation("VersionSteps", fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  payoutOf       WorkflowVersion[] @relation("VersionPayoutStep")
  stepType       StepType        @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: NoAction)
  sopFileVersion FileVersion?    @relation(fields: [tenantId, sopFileVersionId], references: [tenantId, id], onDelete: NoAction)
  workOrders     WorkOrder[]
  transitionsFrom Transition[] @relation("TransitionFrom")
  transitionsTo   Transition[] @relation("TransitionTo")
  sampleDraws     SampleDraw[]

  @@unique([versionId, key])
  @@unique([versionId, position])
  @@unique([tenantId, id])
  @@map("workflow_step")
}

// The pieces started together from one source (a quote now, an order line later), all on one
// workflow version (D34). Its progress is derived from its work orders, never stored (D39).
model WorkOrderGroup {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  workflowVersionId String   @map("workflow_version_id") @db.Uuid
  // quote | order_line | claim_line (a remake, Orders 3 spec, goal 3)
  sourceType        String   @map("source_type")
  sourceId          String   @map("source_id") @db.Uuid
  // The quote the pieces were priced by, whichever source started them (Orders plan, Task 3).
  quoteId           String?  @map("quote_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  fileVersionId     String?  @map("file_version_id") @db.Uuid
  customerId        String?  @map("customer_id") @db.Uuid
  // How many good pieces the group must deliver.
  quantity          Int
  // Higher first in the work queue: its customer's band in force when that band is first in line, else 0
  // (Customers 2 spec, goal 17). Kept by PriorityService.rerank.
  queueRank         Int      @default(0) @map("queue_rank")
  // The step types the source priced, which decide the priced steps on the path; null: every step runs.
  chainStepTypeIds  Json?    @map("chain_step_type_ids")
  parentGroupId     String?  @map("parent_group_id") @db.Uuid
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [tenantId, workflowVersionId], references: [tenantId, id], onDelete: NoAction)
  quote           Quote?          @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: NoAction)
  product         Product?        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction)
  fileVersion     FileVersion?    @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)
  customer        Customer?       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  workOrders      WorkOrder[]
  assignments     JobAssignment[]
  rating          JobRating?
  orderLine       OrderLine?
  orderLinePart   OrderLinePart?
  // A part's group names its assembly's, whose pieces wait for every part (Orders spec, goal 6).
  parent          WorkOrderGroup?  @relation("GroupParts", fields: [tenantId, parentGroupId], references: [tenantId, id], onDelete: NoAction)
  children        WorkOrderGroup[] @relation("GroupParts")
  sampleDraws     SampleDraw[]
  remakeOf        ClaimLine?

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, id])
  @@index([tenantId, queueRank])
  @@map("work_order_group")
}

// One piece (serial tracking, F3). `currentStepId` is set exactly while the piece is active.
model WorkOrder {
  // Given in number order when a group starts, so a list by id lists pieces 1, 2, 3...
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  // 1..quantity; a replacement keeps the number of the piece it replaces.
  number        Int
  // active | finished | scrapped | cancelled
  status        String   @default("active")
  currentStepId String?  @map("current_step_id") @db.Uuid
  replacesId    String?  @map("replaces_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       WorkOrderGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  currentStep WorkflowStep?  @relation(fields: [tenantId, currentStepId], references: [tenantId, id], onDelete: NoAction)
  replaces    WorkOrder?     @relation("Replacement", fields: [tenantId, replacesId], references: [tenantId, id], onDelete: NoAction)
  // Several only when a restored piece is scrapped again; at most one is ever active.
  replacements WorkOrder[]   @relation("Replacement")
  transitions  Transition[]
  samples      SamplePiece[]

  @@unique([tenantId, id])
  @@index([tenantId, replacesId])
  @@index([tenantId, currentStepId])
  @@index([groupId, number])
  @@map("work_order")
}

// One move of one piece (D37, ADR 0003): append-only, written only by the move command. The from-step
// and from-status are read from the piece, never sent by the client (D35). A correction is a new row.
model Transition {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  // pass | fail | correction
  kind           String
  // rework | scrap | continue on a fail; null otherwise
  outcome        String?
  // Null when the piece wasn't at a step (finished, scrapped) or didn't land on one.
  fromStepId     String?  @map("from_step_id") @db.Uuid
  toStepId       String?  @map("to_step_id") @db.Uuid
  fromStatus     String   @map("from_status")
  toStatus       String   @map("to_status")
  defectId       String?  @map("defect_id") @db.Uuid
  // Why the defect's default outcome or rework target was not followed (D38).
  overrideReason String?  @map("override_reason")
  comment        String?
  actorUserId    String   @map("actor_user_id") @db.Uuid
  // The partner the move counts for: the job's accepted partner, at a partner step; null otherwise
  // (Partners spec, B5). Whoever made it, staff or the partner's own people.
  partnerId      String?  @map("partner_id") @db.Uuid
  // False for a pass of a piece left out of its step's sample (Workflow 2 spec, goal 5): no checklist,
  // no photos, never counted as a QC result.
  inspected      Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NoAction: a piece with history can't be deleted; only deleting the workspace removes both.
  workOrder WorkOrder        @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: NoAction)
  partner   Partner?         @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  fromStep  WorkflowStep?    @relation("TransitionFrom", fields: [tenantId, fromStepId], references: [tenantId, id], onDelete: NoAction)
  toStep    WorkflowStep?    @relation("TransitionTo", fields: [tenantId, toStepId], references: [tenantId, id], onDelete: NoAction)
  defect    Defect?          @relation(fields: [tenantId, defectId], references: [tenantId, id], onDelete: NoAction)
  actor     User             @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction)
  answers   TransitionAnswer[]
  photos    TransitionPhoto[]
  endedDraws SampleDraw[]

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, fromStepId])
  @@index([tenantId, toStepId])
  @@index([tenantId, defectId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, partnerId])
  @@map("transition")
}

// The random sample of one group at one sampling step (Workflow 2 spec, goals 2–3): drawn once, the
// first time a piece of the group reaches the step, and never changed. A fail at the step ends it.
model SampleDraw {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId             String    @map("group_id") @db.Uuid
  stepId              String    @map("step_id") @db.Uuid
  drawnAt             DateTime  @default(now()) @map("drawn_at")
  // Set with the fail that ended sampling; every piece is inspected in full from then on (goal 6).
  endedAt             DateTime? @map("ended_at")
  endedByTransitionId String?   @map("ended_by_transition_id") @db.Uuid

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group           WorkOrderGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  step            WorkflowStep   @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  endedBy         Transition?    @relation(fields: [tenantId, endedByTransitionId], references: [tenantId, id], onDelete: NoAction)
  pieces          SamplePiece[]

  @@unique([tenantId, groupId, stepId])
  @@unique([tenantId, id])
  @@index([tenantId, stepId])
  @@index([tenantId, endedByTransitionId])
  @@map("sample_draw")
}

// A piece drawn into a sample, as drawn. A scrapped piece's place is followed to its replacement in
// code, never by changing this row.
model SamplePiece {
  tenantId    String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  drawId      String @map("draw_id") @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draw      SampleDraw @relation(fields: [tenantId, drawId], references: [tenantId, id], onDelete: Cascade)
  workOrder WorkOrder  @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, drawId, workOrderId])
  @@index([tenantId, workOrderId])
  @@map("sample_piece")
}

// A checklist answer given with a move, as it was given: one row per item and transition.
model TransitionAnswer {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  transitionId String  @map("transition_id") @db.Uuid
  itemKey      String  @map("item_key")
  // A choice's option key, a decimal, text, or true/false for a yes/no question.
  value        String
  note         String?
  // Whether the answer met the item's check when it was given.
  passing      Boolean

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transition Transition @relation(fields: [tenantId, transitionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, transitionId])
  @@map("transition_answer")
}

model TransitionPhoto {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  transitionId  String @map("transition_id") @db.Uuid
  fileVersionId String @map("file_version_id") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transition  Transition  @relation(fields: [tenantId, transitionId], references: [tenantId, id], onDelete: Cascade)
  fileVersion FileVersion @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, transitionId])
  @@index([tenantId, fileVersionId])
  @@map("transition_photo")
}

// ---------------------------------------------------------------------------
// Partners (Partners spec): outside workshops that make the pieces.

// A partner workshop. Its people are users with partner memberships (organisation_membership,
// organisation_type = 'partner'), as customers' people are.
model Partner {
  id                      String    @id @default(uuid(7)) @db.Uuid
  tenantId                String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name                    String
  // What customers see when they may pick a workshop.
  displayName             String    @map("display_name")
  // setting_up | approved | suspended: only approved partners are offered jobs
  status                  String    @default("setting_up")
  // Takes any job a customer sends it directly, without an offer (goal 11).
  acceptsDirectOrders     Boolean   @default(false) @map("accepts_direct_orders")
  agreementFileVersionId  String?   @map("agreement_file_version_id") @db.Uuid
  agreementSignedOn       DateTime? @map("agreement_signed_on") @db.Date
  // Jobs offered or accepted at once; null for no limit.
  maxOpenJobs             Int?      @map("max_open_jobs")
  // When the partner's owner said its setup is ready for approval (goal 17); set once.
  submittedAt             DateTime? @map("submitted_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreementVersion FileVersion?          @relation(fields: [tenantId, agreementFileVersionId], references: [tenantId, id], onDelete: NoAction)
  invitations      PartnerInvitation[]
  capabilities     PartnerCapability[]
  closedPeriods    PartnerClosedPeriod[]
  offerings        PartnerOffering[]
  stepPrices       PartnerStepPrice[]
  assignments      JobAssignment[]
  transitions      Transition[]
  quotes           Quote[]
  ratings          JobRating[]
  capacitySnapshots PartnerCapacitySnapshot[]
  comments         OrderComment[]
  ledgerJournals   LedgerJournal[]
  ledgerLines      LedgerLine[]
  payoutAccount    PartnerPayoutAccount?
  payouts          Payout[]
  claimLines       ClaimLine[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("partner")
}

// An invitation to act for a partner with a role. Accepting creates the partner person, or adds a
// membership when the email already belongs to one (Partners spec, goal 1).
model PartnerInvitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId       String    @map("partner_id") @db.Uuid
  // Lowercased.
  email           String
  // owner | admin | member
  role            String
  tokenHash       String    @unique @map("token_hash")
  // A staff user or a partner person.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, partnerId, email])
  @@map("partner_invitation")
}

// A step type a partner can do, within limits, and how many pieces it can take per period (goals 4, 5).
model PartnerCapability {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  // Pieces per job.
  minQuantity    Int      @default(1) @map("min_quantity")
  maxQuantity    Int?     @map("max_quantity")
  // The largest side of a piece's bounding box.
  maxSizeMm      Decimal? @map("max_size_mm") @db.Decimal(18, 6)
  // Pieces per capacity period.
  capacity       Int
  // day | week
  capacityPeriod String   @map("capacity_period")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner  Partner  @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: NoAction)

  @@unique([partnerId, stepTypeId])
  @@index([tenantId, partnerId])
  @@index([tenantId, stepTypeId])
  @@map("partner_capability")
}

// Days a partner takes no work, both ends included (goal 5).
model PartnerClosedPeriod {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  note      String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, partnerId])
  @@map("partner_closed_period")
}

// An option value a partner works with: it is only offered jobs whose values it all offers (goal 6).
model PartnerOffering {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId     String @map("partner_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     Partner     @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  optionValue OptionValue @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([partnerId, optionValueId])
  @@index([tenantId, partnerId])
  @@index([tenantId, optionValueId])
  @@map("partner_offering")
}

// A partner's price for a step, as a workspace step price: for one material or as the step's default
// (goal 8). Saves lock the partner row, so two defaults for a step can't be written side by side.
model PartnerStepPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  materialId     String?  @map("material_id") @db.Uuid
  failurePercent Decimal  @map("failure_percent") @db.Decimal(9, 4)
  // Validated by blocksSchema (src/modules/pricing/blocks.ts) on every save.
  blocks         Json
  // Staff copied it from the workspace's own price, which the partner never sees; saving it makes it
  // the partner's own.
  copiedFromWorkspace Boolean @default(false) @map("copied_from_workspace")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner  Partner   @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType  @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)
  material Material? @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Cascade)

  @@unique([partnerId, stepTypeId, materialId])
  @@index([tenantId, partnerId])
  @@index([tenantId, stepTypeId])
  @@index([tenantId, materialId])
  @@map("partner_step_price")
}

// A job (a work order group) handed to a partner: an offer, a direct send, or a reassignment (goals 10,
// 11, P16). Every row is kept as history. At most one row per group is `offered` or `accepted`, which
// writes keep under a lock on the group row.
model JobAssignment {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId            String    @map("group_id") @db.Uuid
  partnerId          String    @map("partner_id") @db.Uuid
  // offer | direct | reassign
  kind               String
  // offered | accepted | declined | expired | withdrawn | replaced
  status             String
  // What the partner is paid for the job, frozen when it is handed over.
  cost               Decimal   @db.Decimal(18, 2)
  // Set by staff instead of `cost`, with a reason, such as for a partner replaced mid-way (P16).
  owedOverride       Decimal?  @map("owed_override") @db.Decimal(18, 2)
  owedOverrideReason String?   @map("owed_override_reason")
  // When an offer lapses; null for a job handed over without an offer.
  expiresAt          DateTime? @map("expires_at")
  respondedAt        DateTime? @map("responded_at")
  // The day the partner should have the job done by; null for a job that isn't an order line, unless staff gave one.
  dueOn              DateTime? @map("due_on") @db.Date
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   WorkOrderGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  partner Partner        @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  payoutJobs PayoutJob[]
  summaries  JobSummary[]
  // Remake labels charged to the workshop at fault for this job (Orders 3b plan, Task 5).
  chargedLabels Shipment[]

  @@unique([tenantId, id])
  @@index([tenantId, groupId])
  @@index([tenantId, partnerId, status])
  @@index([status, expiresAt])
  // At most one offered or accepted row per job: trigger job_assignment_one_open (migration
  // 20261025140000_job_assignment_one_open).
  @@map("job_assignment")
}

// A partner's load and capacity at one step type on one day (Partners spec, D83): the one stored
// counter, kept daily so capacity history outlives the jobs it was read from.
model PartnerCapacitySnapshot {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // The UTC day.
  date           DateTime @db.Date
  partnerId      String   @map("partner_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  // Pieces offered to or accepted by the partner that still had this step ahead of them.
  load           Int
  // The capability's capacity that day, per `capacityPeriod` (day | week).
  capacity       Int
  capacityPeriod String   @map("capacity_period")
  createdAt      DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner  Partner  @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, date, partnerId, stepTypeId])
  @@unique([tenantId, id])
  @@index([tenantId, partnerId, date])
  @@index([tenantId, stepTypeId])
  @@map("partner_capacity_snapshot")
}

// A customer's rating of a finished job, for the partner that made it (Partners spec, goal 16): once per job.
model JobRating {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId           String   @map("group_id") @db.Uuid
  partnerId         String   @map("partner_id") @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  // 1..5
  stars             Int
  comment           String?
  // Staff let the partner read the comment, never who wrote it (P15).
  sharedWithPartner Boolean  @default(false) @map("shared_with_partner")
  ratedByUserId     String   @map("rated_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group    WorkOrderGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  partner  Partner        @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  customer Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, groupId])
  @@unique([tenantId, id])
  @@index([tenantId, partnerId, createdAt])
  @@index([tenantId, customerId])
  @@map("job_rating")
}

// ---------------------------------------------------------------------------
// Orders (Orders spec): what customers buy, made to order and shipped.

// A way an order reaches the customer, with its price per order (Orders spec, goal 9). Switched off,
// never deleted: past orders keep naming it.
model ShippingMethod {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  // Per order; null for a live-rate method, priced by the courier service for each order (Orders 3 spec, goal 22).
  price     Decimal? @db.Decimal(18, 2)
  // The courier service's carrier and service a live-rate method is priced and labelled by; both or neither.
  liveCarrier   String? @map("live_carrier")
  liveService   String? @map("live_service")
  // The parcel a live rate is asked for, and a label's default: { weight_g, length_cm, width_cm, height_cm }.
  defaultParcel Json?   @map("default_parcel")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("shipping_method")
}

// A tax rate for a country, or a region of it; the row without a country is the workspace's default
// (Orders spec, goal 10 and B2). One row per place, kept by replacing the whole list under a lock.
model TaxRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // ISO 3166-1 alpha-2; null for the default rate.
  country   String?  @db.Char(2)
  // Only with a country.
  region    String?
  percent   Decimal  @db.Decimal(9, 4)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, country])
  @@map("tax_rate")
}

// What a customer buys: lines priced by the quotes shown, with the totals frozen when it was placed
// (Orders spec, goals 1, 2, 11). Its state is derived from its lines' pieces, never stored.
model Order {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // Readable, counted per workspace from 1001 (order_counter).
  number           Int
  customerId       String   @map("customer_id") @db.Uuid
  // The customer's group when the order was placed, so revenue by group never moves with the customer
  // (Customers 2 spec, goal 5).
  customerGroupId  String?  @map("customer_group_id") @db.Uuid
  // staff | portal; outside channels later (goal 17)
  channel          String
  // The outside channel's own id, taken once per channel.
  channelOrderId   String?  @map("channel_order_id")
  // Every line's quote names this speed; null when the workspace has none.
  deliverySpeedKey String?  @map("delivery_speed_key")
  promisedOn       DateTime @map("promised_on") @db.Date
  // Validated by addressSchema (order-response.ts), copied from what was typed.
  address          Json
  shippingMethodId String   @map("shipping_method_id") @db.Uuid
  shippingPrice    Decimal  @map("shipping_price") @db.Decimal(18, 2)
  linesTotal       Decimal  @map("lines_total") @db.Decimal(18, 2)
  taxPercent       Decimal  @map("tax_percent") @db.Decimal(9, 4)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(18, 2)
  total            Decimal  @db.Decimal(18, 2)
  currency         String   @db.Char(3)
  note             String?
  placedByUserId   String   @map("placed_by_user_id") @db.Uuid
  placedAt         DateTime @default(now()) @map("placed_at")
  // Shipment facts (goal 9): with cancelling and the pieces, what the order's state is decided from.
  courier          String?
  tracking         String?
  shippedAt        DateTime? @map("shipped_at")
  deliveredAt      DateTime? @map("delivered_at")
  // Set, with the reason, once every line is cancelled (goal 12).
  cancelledAt      DateTime? @map("cancelled_at")
  cancelReason     String?   @map("cancel_reason")
  // pay_first | pay_later: the customer's terms, frozen when the order was placed (Payments spec).
  paymentTerms     String    @map("payment_terms")
  // Waiting because the customer is past its credit limit.
  heldForCredit    Boolean   @default(false) @map("held_for_credit")
  // A pay-first order not paid by then is cancelled.
  payBy            DateTime? @map("pay_by")
  // Null while the order waits for payment or credit: nothing of it is made, its workshop's job is held.
  productionStartedAt DateTime? @map("production_started_at")
  // Who let it start past the credit limit, and why.
  releasedByUserId String?   @map("released_by_user_id") @db.Uuid
  releaseReason    String?   @map("release_reason")
  // The order's state and payment state, stored so lists filter and count them (Orders list spec, goals
  // 1 and 5). Null: not computed yet. OrderStatesService is the only writer; the rules live in
  // order-state.ts and payment-state.ts.
  state            String?
  paymentState     String?   @map("payment_state")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  customerGroup  CustomerGroup? @relation(fields: [tenantId, customerGroupId], references: [tenantId, id], onDelete: NoAction)
  shippingMethod ShippingMethod @relation(fields: [tenantId, shippingMethodId], references: [tenantId, id], onDelete: NoAction)
  releasedBy     User?          @relation(fields: [tenantId, releasedByUserId], references: [tenantId, id], onDelete: NoAction)
  lines          OrderLine[]
  comments       OrderComment[]
  ledgerJournals LedgerJournal[]
  payments       OrderPayment[]
  invoice        Invoice?
  refunds        Refund[]
  progressEmails OrderProgressEmail[]
  claims         Claim[]
  creditNotes    CreditNote[]
  shipments      Shipment[]

  @@unique([tenantId, number])
  @@unique([tenantId, channel, channelOrderId])
  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@index([tenantId, state, promisedOn, id])
  @@index([tenantId, paymentState])
  @@index([tenantId, promisedOn, id])
  @@map("order")
}

// A progress email sent for an order (Workflow 2 spec, goals 16–18): one per customer-facing step name,
// so rework, replacements and corrections never send it again.
model OrderProgressEmail {
  tenantId String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId  String   @map("order_id") @db.Uuid
  stepName String   @map("step_name")
  sentAt   DateTime @default(now()) @map("sent_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, orderId, stepName])
  @@map("order_progress_email")
}

// A claim on a delivered order (Orders 3 spec, goals 1–7): some pieces of some lines are faulty,
// damaged or wrong. Its state is derived from its return and its lines, never stored.
model Claim {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  // Readable, counted per workspace from 1.
  number           Int
  // A key of the `orders.claims` reasons when opened; kept as it was if the reason is removed later.
  reason           String
  description      String
  openedByUserId   String    @map("opened_by_user_id") @db.Uuid
  // staff | customer
  openedByKind     String    @map("opened_by_kind")
  // Staff asked for the pieces back; the claim waits until they are received.
  returnRequestedAt DateTime? @map("return_requested_at")
  returnedAt       DateTime? @map("returned_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  openedBy User           @relation(fields: [tenantId, openedByUserId], references: [tenantId, id], onDelete: NoAction)
  lines    ClaimLine[]
  photos   ClaimPhoto[]
  shipment ClaimShipment?
  // Labels bought for the claim: the return label, and the remake's (Orders 3 spec, goal 25).
  labels   Shipment[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("claim")
}

// Some pieces of one order line, and staff's decision on them, stored once and never changed.
model ClaimLine {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  claimId         String    @map("claim_id") @db.Uuid
  orderLineId     String    @map("order_line_id") @db.Uuid
  pieces          Int
  // workshop | workspace | courier | customer
  fault           String?
  // remake | refund | refuse
  outcome         String?
  // Staff's own, never shown to the customer.
  note            String?
  // Shown to the customer; required for a refusal.
  customerReason  String?   @map("customer_reason")
  refundAmount    Decimal?  @map("refund_amount") @db.Decimal(18, 2)
  // The workshop at fault.
  partnerId       String?   @map("partner_id") @db.Uuid
  remakeGroupId   String?   @map("remake_group_id") @db.Uuid
  // What the workshop at fault is owed less for the original job; set once.
  owedReduction   Decimal?  @map("owed_reduction") @db.Decimal(18, 2)
  // What it was already paid and should not have been, for staff to settle by hand.
  shortfall       Decimal?  @db.Decimal(18, 2)
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at")

  claim       Claim           @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Cascade)
  orderLine   OrderLine       @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: NoAction)
  partner     Partner?        @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  remakeGroup WorkOrderGroup? @relation(fields: [tenantId, remakeGroupId], references: [tenantId, id], onDelete: NoAction)
  decidedBy   User?           @relation(fields: [tenantId, decidedByUserId], references: [tenantId, id], onDelete: NoAction)
  creditNotes CreditNote[]

  @@unique([claimId, orderLineId])
  @@unique([tenantId, id])
  @@unique([tenantId, remakeGroupId])
  @@index([tenantId, orderLineId])
  @@index([tenantId, partnerId, decidedAt])
  @@map("claim_line")
}

model ClaimPhoto {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  claimId       String @map("claim_id") @db.Uuid
  fileVersionId String @map("file_version_id") @db.Uuid
  position      Int

  claim       Claim       @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Cascade)
  fileVersion FileVersion @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)

  @@unique([claimId, position])
  @@unique([claimId, fileVersionId])
  @@index([tenantId, fileVersionId])
  @@map("claim_photo")
}

// The parcel carrying a claim's remakes; the original order stays delivered (Orders 3 spec, goal 3).
model ClaimShipment {
  claimId     String    @id @map("claim_id") @db.Uuid
  tenantId    String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  courier     String?
  tracking    String?
  shippedAt   DateTime  @default(now()) @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")

  claim Claim @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, claimId])
  @@map("claim_shipment")
}

// Lowers what is still open on an order's invoice, at the payment provider (Orders 3 spec, goal 3):
// the part of a claim's refund that was never paid.
model CreditNote {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  invoiceId            String   @map("invoice_id") @db.Uuid
  claimLineId          String   @map("claim_line_id") @db.Uuid
  amount               Decimal  @db.Decimal(18, 2)
  providerCreditNoteId String?  @map("provider_credit_note_id")
  // pending | issued | failed
  status               String   @default("pending")
  createdAt            DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: NoAction)
  claimLine ClaimLine @relation(fields: [tenantId, claimLineId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, providerCreditNoteId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, claimLineId])
  @@map("credit_note")
}

// A label bought from the workspace's courier service (Orders 3 spec, goals 23 and 25): for an order, a
// claim's remake, or a claim's return. Reserved `pending` before anything is sent to the service, so a
// second purchase is refused (trigger shipment_one_open, migration orders_3b); the service's shipment id
// is kept before buying, so a retry buys the same shipment.
model Shipment {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // order | remake | return
  purpose             String
  orderId             String?   @map("order_id") @db.Uuid
  claimId             String?   @map("claim_id") @db.Uuid
  // pending | bought | failed
  status              String    @default("pending")
  providerShipmentId  String?   @map("provider_shipment_id")
  carrier             String
  service             String
  tracking            String?
  labelUrl            String?   @map("label_url")
  cost                Decimal?  @db.Decimal(18, 2)
  currency            String?
  // { weight_g, length_cm, width_cm, height_cm }
  parcel              Json
  // The courier's last tracking state: pre_transit | in_transit | out_for_delivery | delivered | returned | failure | unknown
  trackingStatus      String?   @map("tracking_status")
  // Why the last purchase failed, as the service said it.
  error               String?
  // A remake label charged to the workshop at fault: the job it is taken off, and how (Orders 3 spec, "My calls").
  chargedAssignmentId String?   @map("charged_assignment_id") @db.Uuid
  owedReduction       Decimal?  @map("owed_reduction") @db.Decimal(18, 2)
  shortfall           Decimal?  @db.Decimal(18, 2)
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  deliveredAt         DateTime? @map("delivered_at")

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order            Order?         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  claim            Claim?         @relation(fields: [tenantId, claimId], references: [tenantId, id], onDelete: Cascade)
  chargedAssignment JobAssignment? @relation(fields: [tenantId, chargedAssignmentId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@index([tenantId, claimId])
  @@index([tenantId, tracking])
  @@map("shipment")
}

// A tracking event from the courier service, stored once and applied by a job (Orders 3 spec, goal 24);
// the payload itself is never kept.
model CourierEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  providerEventId String    @map("provider_event_id")
  tracking        String
  status          String
  receivedAt      DateTime  @default(now()) @map("received_at")
  appliedAt       DateTime? @map("applied_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerEventId])
  @@unique([tenantId, id])
  @@map("courier_event")
}

// The workspace's own courier service account (Orders 3 spec, goal 21), sealed at rest like the payment keys.
model CourierAccount {
  tenantId      String   @id @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // easypost
  provider      String   @default("easypost")
  apiKey        Bytes    @map("api_key")
  webhookSecret Bytes    @map("webhook_secret")
  // Where labels ship from and returns go to; validated by addressSchema.
  fromAddress   Json     @map("from_address")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("courier_account")
}

// How many pieces a day the workspace can put through an in-house step type, shared by every workflow
// using it (Orders 3 spec, goal 16). A step type without a row is planned without a limit.
model StepCapacity {
  tenantId    String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  stepTypeId  String   @map("step_type_id") @db.Uuid
  dailyPieces Int      @map("daily_pieces")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, stepTypeId])
  @@map("step_capacity")
}

// The AI's brief of a job for the workshop holding it (Orders 3 spec, goals 12–15). The sweep writes one
// per job (`requested_by_user_id` null; trigger job_summary_one_swept, migration orders_3b); staff may ask for
// more. The content is set once its run is done.
model JobSummary {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  assignmentId      String   @map("assignment_id") @db.Uuid
  runId             String   @unique @map("run_id") @db.Uuid
  description       String?
  watchOuts         Json?    @map("watch_outs")
  recommendations   Json?
  productionDays    Int?     @map("production_days")
  usedHistory       Boolean? @map("used_history")
  requestedByUserId String?  @map("requested_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment JobAssignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)
  run        AiRun         @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, runId])
  @@unique([tenantId, id])
  @@index([tenantId, assignmentId])
  @@map("job_summary")
}

// A customer's priority (Customers 2 spec, goals 11–16): its score from its own history, computed each
// night, the band that gives, and a staff override until a date. Band keys name `customers.priority`
// bands; one no longer there reads as the default band. Never shown to the customer.
model CustomerPriority {
  tenantId         String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  score            Int
  // { lifetime, recent, frequency, payment }, each 0–100.
  parts            Json
  // Null: the default band.
  bandKey          String?   @map("band_key")
  computedAt       DateTime  @map("computed_at")
  // Set together, or not at all (check in the migration). In force through `overrideEndsOn`.
  overrideBandKey  String?   @map("override_band_key")
  overrideReason   String?   @map("override_reason")
  overrideEndsOn   DateTime? @map("override_ends_on") @db.Date
  overrideByUserId String?   @map("override_by_user_id") @db.Uuid

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  overrideBy User?    @relation(fields: [tenantId, overrideByUserId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, customerId])
  @@index([tenantId, bandKey])
  @@map("customer_priority")
}

// A comment on an order or one of its lines, by staff, the customer's people or the partner holding the
// line (Orders spec, goal 13). Who reads it is decided by `visibility`, never by the reader's own choice.
// No edit or delete in this version.
model OrderComment {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  // An order line or a sub-line of it, checked when written; null for the order as a whole.
  lineId       String?  @map("line_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  // staff | customer | partner
  authorKind   String   @map("author_kind")
  // Set exactly when the author is a partner.
  partnerId    String?  @map("partner_id") @db.Uuid
  // customer | partner | staff: who reads it besides staff. A customer's or partner's own comment is its
  // author kind; `partner` is on a line, read by the partner holding it.
  visibility   String
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  // Direct to the tenant as well: the author is deleted with the tenant, and the cascade through the
  // order alone is not guaranteed to remove the comment first.
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order                    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  author     User                     @relation(fields: [tenantId, authorUserId], references: [tenantId, id], onDelete: NoAction)
  partner     Partner?                 @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  attachments OrderCommentAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId, id])
  @@map("order_comment")
}

// At most 10 per comment (CHECK in the migration).
model OrderCommentAttachment {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  commentId     String @map("comment_id") @db.Uuid
  fileVersionId String @map("file_version_id") @db.Uuid
  position      Int

  comment     OrderComment @relation(fields: [tenantId, commentId], references: [tenantId, id], onDelete: Cascade)
  fileVersion FileVersion  @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)

  @@unique([commentId, position])
  @@unique([commentId, fileVersionId])
  @@index([tenantId, fileVersionId])
  @@map("order_comment_attachment")
}

// One configured product of an order, priced by its quote and made as one work order group
// (Orders spec, goals 1–4).
model OrderLine {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  // From 0, in the order the lines were sent.
  position   Int
  // A quote is ordered once.
  quoteId    String    @map("quote_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal   @map("unit_price") @db.Decimal(18, 2)
  total      Decimal   @db.Decimal(18, 2)
  // What was picked (options by name, size, design file), copied when the order is placed and never
  // changed; `linePicksSchema` (line-picks.ts). The default is a line placed before it was kept.
  picks      Json      @default("{\"options\":[],\"size\":null,\"design_file\":null}")
  // Set as soon as the line starts, in the transaction that places the order.
  groupId    String?   @map("group_id") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  quote   Quote           @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: NoAction)
  product Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction)
  group   WorkOrderGroup? @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: NoAction)
  parts   OrderLinePart[]
  claimLines ClaimLine[]

  @@unique([tenantId, quoteId])
  @@unique([tenantId, groupId])
  @@unique([orderId, position])
  @@unique([tenantId, id])
  @@map("order_line")
}

// One part of an assembly line, a sub-line: priced by its part's quote and made as its own work
// order group, under the line's (Orders spec, goal 6). Never a line of its own: states, cancelling
// and the one-partner rule go by the order's lines.
model OrderLinePart {
  id        String  @id @default(uuid(7)) @db.Uuid
  tenantId  String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  lineId    String  @map("line_id") @db.Uuid
  // The part's position in its assembly.
  position  Int
  quoteId   String  @map("quote_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  // The line's quantity times how many go into one.
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)
  total     Decimal @db.Decimal(18, 2)
  // What the part was made with, copied like its line's (`linePicksSchema`).
  picks     Json    @default("{\"options\":[],\"size\":null,\"design_file\":null}")
  // Set as soon as the part starts, in the transaction that places the order.
  groupId   String? @map("group_id") @db.Uuid

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  line    OrderLine       @relation(fields: [tenantId, lineId], references: [tenantId, id], onDelete: Cascade)
  quote   Quote           @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: NoAction)
  product Product         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction)
  group   WorkOrderGroup? @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, quoteId])
  @@unique([tenantId, groupId])
  @@unique([lineId, position])
  @@index([tenantId])
  @@map("order_line_part")
}

// The last order number a workspace gave out; one row per workspace, raised under its row lock.
model OrderCounter {
  tenantId   String @id @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  lastNumber Int    @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("order_counter")
}

// ---------------------------------------------------------------------------
// Payments (Payments spec). A workspace's own payment provider account: one row per workspace.
// The keys are sealed with deriveKey(APP_SECRET, 'payment-keys'); they never leave in a response,
// a log or an audit entry.
// ---------------------------------------------------------------------------
model PaymentAccount {
  tenantId            String   @id @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  secretKey           Bytes    @map("secret_key")
  webhookSecret       Bytes    @map("webhook_secret")
  connectWebhookSecret Bytes   @map("connect_webhook_secret")
  publishableKey      String   @map("publishable_key")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_account")
}

// One movement of money: lines that sum to zero (debit positive, credit negative), written once and
// never changed (ADR 0003). A correction is a new journal of kind `reversal`. The database refuses a
// journal that does not balance, at commit. The payout and refund ids point at tables of later
// tasks, so they carry no key yet.
model LedgerJournal {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // order_billed | payment_received | provider_fee | refund | payout | reversal
  kind              String
  occurredAt        DateTime @map("occurred_at")
  currency          String   @db.Char(3)
  orderId           String?  @map("order_id") @db.Uuid
  customerId        String?  @map("customer_id") @db.Uuid
  partnerId         String?  @map("partner_id") @db.Uuid
  payoutId          String?  @map("payout_id") @db.Uuid
  refundId          String?  @map("refund_id") @db.Uuid
  // The provider's id for the fact this journal records; posting the same fact twice is a no-op.
  providerObjectId  String?  @map("provider_object_id")
  reversesJournalId String?  @map("reverses_journal_id") @db.Uuid
  createdByUserId   String?  @map("created_by_user_id") @db.Uuid
  memo              String   @default("")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order?         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: NoAction)
  customer  Customer?      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  partner   Partner?       @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  createdBy User?          @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  reverses  LedgerJournal? @relation("reversal", fields: [tenantId, reversesJournalId], references: [tenantId, id], onDelete: NoAction)
  reversedBy LedgerJournal? @relation("reversal")
  lines     LedgerLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, kind, providerObjectId])
  @@unique([tenantId, reversesJournalId])
  @@index([tenantId, customerId])
  @@index([tenantId, partnerId])
  @@index([tenantId, orderId])
  @@map("ledger_journal")
}

model LedgerLine {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  journalId  String  @map("journal_id") @db.Uuid
  // customer_receivable | stripe_balance | outside_stripe | sales | tax_payable | provider_fees | partner_costs
  account    String
  // Debit positive, credit negative; never zero.
  amount     Decimal @db.Decimal(18, 2)
  customerId String? @map("customer_id") @db.Uuid
  partnerId  String? @map("partner_id") @db.Uuid

  journal  LedgerJournal @relation(fields: [tenantId, journalId], references: [tenantId, id], onDelete: Cascade)
  customer Customer?     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  partner  Partner?      @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, journalId])
  @@index([tenantId, account, customerId])
  @@index([tenantId, account, partnerId])
  @@map("ledger_line")
}

// One checkout a pay-first order's customer may pay through (Payments spec). At most one is open per
// order, kept by a trigger. The row is written first, so its id is the provider's idempotency key; the
// provider's id and link arrive once it has answered.
model OrderPayment {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  providerCheckoutId String?  @map("provider_checkout_id")
  url                String?
  amount             Decimal  @db.Decimal(18, 2)
  currency           String   @db.Char(3)
  // open | complete | expired
  status             String
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, providerCheckoutId])
  @@index([tenantId, orderId])
  @@map("order_payment")
}

// A pay-later order's invoice, made once it ships (Payments spec). Written `creating` before the
// provider is called, so a retried job finds it and makes the same invoice there.
model Invoice {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  providerInvoiceId String?   @map("provider_invoice_id")
  url               String?
  linesAmount       Decimal   @map("lines_amount") @db.Decimal(18, 2)
  shipping          Decimal   @db.Decimal(18, 2)
  tax               Decimal   @db.Decimal(18, 2)
  total             Decimal   @db.Decimal(18, 2)
  currency          String    @db.Char(3)
  dueOn             DateTime  @map("due_on") @db.Date
  // creating | open | paid | void
  status            String
  paidAt            DateTime? @map("paid_at")
  overdueNotifiedAt DateTime? @map("overdue_notified_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  creditNotes CreditNote[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@unique([tenantId, providerInvoiceId])
  @@map("invoice")
}

// Money given back for an order (Payments spec). Pending ones count against what is left to refund,
// so two refunds at once never pass what was paid; journalled once it has succeeded.
model Refund {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  amount           Decimal  @db.Decimal(18, 2)
  reason           String
  // provider: through the payment provider | outside: paid outside it, given back outside it
  kind             String
  providerRefundId String?  @map("provider_refund_id")
  // pending | succeeded | failed
  status           String
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  createdBy User?  @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, providerRefundId])
  @@index([tenantId, orderId])
  @@map("refund")
}

// A partner's account at the payment provider, which it is paid through (Payments spec). No row means
// not connected; the state follows the provider's `account.updated` events.
model PartnerPayoutAccount {
  partnerId         String   @id @map("partner_id") @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  providerAccountId String   @map("provider_account_id")
  // onboarding | ready | restricted
  state             String
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, partnerId])
  @@unique([tenantId, providerAccountId])
  @@map("partner_payout_account")
}

// One transfer to a partner of what was due (Payments spec). What pending and paid payouts hold for a
// job counts as paid, so a second payout at once finds nothing left; a failed or reversed one gives
// its jobs back.
model Payout {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId          String    @map("partner_id") @db.Uuid
  amount             Decimal   @db.Decimal(18, 2)
  currency           String    @db.Char(3)
  // pending | paid | failed | reversed
  status             String
  providerTransferId String?   @map("provider_transfer_id")
  failure            String?
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  settledAt          DateTime? @map("settled_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner   Partner     @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  createdBy User        @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  jobs      PayoutJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, providerTransferId])
  @@index([tenantId, partnerId])
  @@map("payout")
}

// What a payout holds for one job: its due when paid, negative when it takes back an amount paid before.
model PayoutJob {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  payoutId     String  @map("payout_id") @db.Uuid
  assignmentId String  @map("assignment_id") @db.Uuid
  amount       Decimal @db.Decimal(18, 2)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payout     Payout        @relation(fields: [tenantId, payoutId], references: [tenantId, id], onDelete: Cascade)
  assignment JobAssignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([payoutId, assignmentId])
  @@index([tenantId, assignmentId])
  @@map("payout_job")
}

// How a customer pays (Payments spec). No row means pay first, within 30 days, with no limit.
model CustomerPaymentTerms {
  customerId         String   @id @map("customer_id") @db.Uuid
  tenantId           String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // pay_first | pay_later
  terms              String
  // For an invoice: 1–120.
  daysToPay          Int      @default(30) @map("days_to_pay")
  // Null means no limit.
  creditLimit        Decimal? @map("credit_limit") @db.Decimal(18, 2)
  // The customer at the payment provider, made with its first invoice.
  providerCustomerId String?  @map("provider_customer_id")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, customerId])
  @@map("customer_payment_terms")
}

// One webhook event from the payment provider, stored once by its id and applied once by the
// `payments.event` job. Only the facts needed to find the object are kept, never the payload: a
// handler reads the object's current state from the provider.
model PaymentEvent {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  providerEventId    String    @map("provider_event_id")
  type               String
  objectId           String    @map("object_id")
  // The partner's connected account, for Connect events.
  connectedAccountId String?   @map("connected_account_id")
  // payments | connect: the endpoint it arrived on.
  endpoint           String
  receivedAt         DateTime  @default(now()) @map("received_at")
  appliedAt          DateTime? @map("applied_at")
  // The last handler failure; cleared once applied.
  error              String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerEventId])
  @@map("payment_event")
}

// ---------------------------------------------------------------------------
// Plans and credits (Payments 2)
// ---------------------------------------------------------------------------

// What a customer subscribes to (Payments 2 spec, goal 1). Benefits are read live: an edit reaches
// every subscriber at once; only the price stays as they signed up (plan_price). One plan per
// workspace is the free default, kept by a per-workspace advisory lock.
model Plan {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key               String
  name              String
  description       String   @default("")
  position          Int      @default(0)
  isDefault         Boolean  @default(false) @map("is_default")
  currency          String   @db.Char(3)
  // Off order prices, after the customer group: 0–100.
  discountPercent   Decimal  @default(0) @map("discount_percent") @db.Decimal(9, 4)
  monthlyCredits    Int      @default(0) @map("monthly_credits")
  // Null means unlimited.
  memberLimit       Int?     @map("member_limit")
  // Switches from PLAN_FEATURES (src/modules/payments/plans/plans.ts).
  features          String[] @default([])
  // active | archived
  status            String   @default("active")
  // The product at the provider, made when the plan is first published.
  providerProductId String?  @map("provider_product_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices PlanPrice[]
  speeds PlanSpeed[]
  campaignTargets CreditCampaignTarget[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("plan")
}

// One amount a plan was ever sold at. Changing a price deactivates the row and adds another, so a
// subscriber keeps the price it pays. At most one active row per plan and interval, under the plan's lock.
model PlanPrice {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  // month | year
  interval        String
  amount          Decimal  @db.Decimal(18, 2)
  currency        String   @db.Char(3)
  active          Boolean  @default(true)
  // The recurring price at the provider, once published.
  providerPriceId String?  @map("provider_price_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  subscriptions          CustomerSubscription[] @relation("subscription_price")
  scheduledSubscriptions CustomerSubscription[] @relation("subscription_scheduled_price")
  pendingSubscriptions   CustomerSubscription[] @relation("subscription_pending_price")

  @@unique([tenantId, id])
  @@unique([tenantId, providerPriceId])
  @@index([tenantId, planId])
  @@map("plan_price")
}

// A delivery speed a plan offers beyond the workspace's default speed, which every plan offers;
// with its own surcharge, or null for the speed's own.
model PlanSpeed {
  planId           String   @map("plan_id") @db.Uuid
  deliverySpeedId  String   @map("delivery_speed_id") @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  surchargePercent Decimal? @map("surcharge_percent") @db.Decimal(9, 4)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan          @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  deliverySpeed DeliverySpeed @relation(fields: [tenantId, deliverySpeedId], references: [tenantId, id], onDelete: Cascade)

  @@id([planId, deliverySpeedId])
  @@index([tenantId])
  @@map("plan_speed")
}

// A customer's subscription, as the provider holds it (Payments 2 spec, D47): one row per customer,
// written only by `SubscriptionsService.sync` from webhooks. Subscribing again after it ended reuses it.
model CustomerSubscription {
  id                     String    @id @default(uuid(7)) @db.Uuid
  tenantId               String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId             String    @map("customer_id") @db.Uuid
  providerSubscriptionId String    @map("provider_subscription_id")
  planPriceId            String    @map("plan_price_id") @db.Uuid
  // incomplete | active | past_due | ended
  status                 String
  currentPeriodStart     DateTime  @map("current_period_start")
  currentPeriodEnd       DateTime  @map("current_period_end")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  // The price it moves to at the end of the period (a downgrade).
  scheduledPlanPriceId   String?   @map("scheduled_plan_price_id") @db.Uuid
  // An upgrade waiting for its prorated invoice to be paid.
  pendingPlanPriceId     String?   @map("pending_plan_price_id") @db.Uuid
  // Where monthly allowances count from: set when the subscription becomes active from no paid plan.
  allowanceAnchor        DateTime? @map("allowance_anchor")
  // When `sync` asked the provider for what this row holds; an older read never overwrites it.
  providerReadAt         DateTime? @map("provider_read_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  planPrice      PlanPrice  @relation("subscription_price", fields: [tenantId, planPriceId], references: [tenantId, id], onDelete: NoAction)
  scheduledPrice PlanPrice? @relation("subscription_scheduled_price", fields: [tenantId, scheduledPlanPriceId], references: [tenantId, id], onDelete: NoAction)
  pendingPrice   PlanPrice? @relation("subscription_pending_price", fields: [tenantId, pendingPlanPriceId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, customerId])
  @@unique([tenantId, providerSubscriptionId])
  @@index([tenantId, planPriceId])
  @@map("customer_subscription")
}

// A notice about a subscription's invoice already sent, such as a failed payment: the provider tells
// of one invoice many times, the customer hears of it once.
model SubscriptionNotice {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  // payment_failed | upgrade_failed
  kind              String
  providerInvoiceId String   @map("provider_invoice_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, providerInvoiceId])
  @@index([tenantId, customerId])
  @@map("subscription_notice")
}

// A period of a subscription the provider has been paid for, one per paid invoice (an invoice of 0
// counts): a paid plan's monthly allowance is granted only inside one. Insert only (ADR 0003).
model SubscriptionPaidPeriod {
  id                     String   @id @default(uuid(7)) @db.Uuid
  tenantId               String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId             String   @map("customer_id") @db.Uuid
  providerSubscriptionId String   @map("provider_subscription_id")
  providerInvoiceId      String   @map("provider_invoice_id")
  periodStart            DateTime @map("period_start")
  periodEnd              DateTime @map("period_end")
  createdAt              DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, providerInvoiceId])
  @@index([tenantId, providerSubscriptionId])
  @@index([tenantId, customerId])
  @@map("subscription_paid_period")
}

// Credits a customer buys once, on any plan (Payments 2 spec, goal 10). Workspace data, sold through a
// checkout for the amount on this row: no price at the provider.
model CreditPack {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name      String
  credits   Int
  price     Decimal  @db.Decimal(18, 2)
  currency  String   @db.Char(3)
  // How long the credits last from payment.
  validDays Int      @map("valid_days")
  // active | archived
  status    String   @default("active")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases CreditPackPurchase[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("credit_pack")
}

// One purchase of a pack, with what was sold copied from it: a later edit of the pack changes nothing here.
model CreditPackPurchase {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  packId             String    @map("pack_id") @db.Uuid
  credits            Int
  price              Decimal   @db.Decimal(18, 2)
  currency           String    @db.Char(3)
  validDays          Int       @map("valid_days")
  // open | paid | expired
  status             String    @default("open")
  providerCheckoutId String?   @map("provider_checkout_id")
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  paidAt             DateTime? @map("paid_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  pack      CreditPack @relation(fields: [tenantId, packId], references: [tenantId, id], onDelete: NoAction)
  createdBy User       @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, providerCheckoutId])
  @@index([tenantId, customerId])
  @@map("credit_pack_purchase")
}

// Free credits given automatically to the customers it targets, once each, within a budget (Payments 2
// spec, goal 11). Its grants are the credit grants that name it.
model CreditCampaign {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name               String
  creditsPerCustomer Int       @map("credits_per_customer")
  // How long a customer's credits last from the grant.
  creditDays         Int       @map("credit_days")
  startsAt           DateTime  @map("starts_at")
  endsAt             DateTime  @map("ends_at")
  // In credits; a grant is never split, so it stops when the next one no longer fits.
  budget             Int
  // draft | active | paused | ended
  status             String    @default("draft")
  // When a customer first found no room left; staff are told then, once.
  budgetUsedAt       DateTime? @map("budget_used_at")
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User                   @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  targets   CreditCampaignTarget[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("credit_campaign")
}

// Who a campaign is for: the customers on a plan, or one customer by name. Exactly one of the two.
model CreditCampaignTarget {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  campaignId String  @map("campaign_id") @db.Uuid
  planId     String? @map("plan_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid
  // Every customer of the group (Customers 2 spec, goal 4).
  customerGroupId String? @map("customer_group_id") @db.Uuid

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign      CreditCampaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  plan          Plan?          @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  customerGroup CustomerGroup? @relation(fields: [tenantId, customerGroupId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, campaignId])
  @@index([tenantId, planId])
  @@index([tenantId, customerId])
  @@index([tenantId, customerGroupId])
  @@map("credit_campaign_target")
}

// Credits given to a customer (Payments 2 spec, D48): a monthly allowance, a pack, a campaign or a staff
// grant. What is left of one is the sum of its entries. Insert only (ADR 0003).
model CreditGrant {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  // allowance | pack | campaign | staff
  source          String
  amount          Int
  grantedAt       DateTime @default(now()) @map("granted_at")
  expiresAt       DateTime @map("expires_at")
  // What the grant is for, such as `campaign:<campaignId>:<customerId>`; asking twice writes it once.
  sourceKey       String   @map("source_key")
  campaignId      String?  @map("campaign_id") @db.Uuid
  packPurchaseId  String?  @map("pack_purchase_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  reason          String?

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  createdBy User?         @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  entries   CreditEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, customerId, expiresAt])
  @@map("credit_grant")
}

// Credits used, or given back when the work they paid for failed. Insert only (ADR 0003).
model CreditSpend {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  // spend | give_back
  kind        String
  amount      Int
  reason      String
  // The caller's id for the work a spend pays for; spending twice for it spends once. Null on a give-back.
  reference   String?
  // The spend a give-back returns, once.
  givesBackId String?  @map("gives_back_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  givesBack  CreditSpend?  @relation("credit_give_back", fields: [tenantId, givesBackId], references: [tenantId, id], onDelete: NoAction)
  givenBack  CreditSpend?  @relation("credit_give_back")
  entries    CreditEntry[]
  aiResult   AiCustomerResult?

  @@unique([tenantId, id])
  @@unique([tenantId, customerId, reference])
  @@unique([tenantId, givesBackId])
  @@map("credit_spend")
}

// One movement of one grant's credits: positive for a grant and a give-back, negative for a spend and
// an expiry. Insert only (ADR 0003).
model CreditEntry {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  grantId    String   @map("grant_id") @db.Uuid
  spendId    String?  @map("spend_id") @db.Uuid
  // grant | spend | give_back | expire
  kind       String
  amount     Int
  occurredAt DateTime @default(now()) @map("occurred_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  grant    CreditGrant  @relation(fields: [tenantId, grantId], references: [tenantId, id], onDelete: Cascade)
  spend    CreditSpend? @relation(fields: [tenantId, spendId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId, id])
  @@index([tenantId, grantId])
  @@index([tenantId, spendId])
  @@map("credit_entry")
}

// ---------------------------------------------------------------------------
// AI (AI 1 spec). The run log is insert only (ADR 0003): a run is its request,
// and its result is a second row once the job has finished. A run without a
// result is pending.
// ---------------------------------------------------------------------------

// One AI call, queued as the `ai.run` job. `input` is what the job needs to run it; never content
// the asking user could not see.
model AiRun {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // Null for the scheduled briefing.
  userId    String?  @map("user_id") @db.Uuid
  // ask | briefing | recommendations | marketing | brand_content | image
  kind      String
  model     String
  input     Json
  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction)
  result         AiRunResult?
  briefing       AiBriefing?
  customerResult AiCustomerResult?
  jobSummary     JobSummary?

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("ai_run")
}

// How a run ended, what it cost and the ids of the records its tools returned (never their content).
model AiRunResult {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  runId        String   @unique @map("run_id") @db.Uuid
  // done | failed
  status       String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  costUsd      Decimal  @map("cost_usd") @db.Decimal(12, 6)
  output       Json?
  // RecordRef[]: { type, id }
  refs         Json
  error        String?
  finishedAt   DateTime @default(now()) @map("finished_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    AiRun  @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, runId])
  @@index([tenantId, finishedAt])
  @@map("ai_run_result")
}

// A notice that the month's AI spend reached 80 % or 100 % of the limit: once per level and month.
model AiLimitNotice {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // YYYY-MM, UTC
  month     String   @db.Char(7)
  level     Int
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month, level])
  @@map("ai_limit_notice")
}

// The managers' morning briefing (AI 1 spec, goal 7): written once, when its run finishes.
model AiBriefing {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  runId     String   @unique @map("run_id") @db.Uuid
  summary   String
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         AiRun          @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: NoAction)
  suggestions AiSuggestion[]

  @@unique([tenantId, runId])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("ai_briefing")
}

// One suggestion of a briefing: a kind fixed in code and the records it names, checked when stored.
model AiSuggestion {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  briefingId  String @map("briefing_id") @db.Uuid
  // From 0, in the order the model gave them.
  position    Int
  kind        String
  // RecordRef[]
  targets     Json
  // Its kind and sorted targets (suggestions.ts): the same suggestion has the same one.
  fingerprint String
  reason      String

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  briefing AiBriefing @relation(fields: [tenantId, briefingId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, briefingId])
  @@map("ai_suggestion")
}

// A suggestion dismissed for the whole workspace: not suggested again for 14 days. Dismissing it again
// starts the 14 days over.
model AiSuggestionDismissal {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  fingerprint       String
  // Given to the briefing's model as what not to suggest.
  kind              String
  targets           Json
  dismissedByUserId String   @map("dismissed_by_user_id") @db.Uuid
  dismissedAt       DateTime @default(now()) @map("dismissed_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dismissedBy User   @relation(fields: [tenantId, dismissedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, fingerprint])
  @@map("ai_suggestion_dismissal")
}

// A customer's use of one AI tool (AI 2 spec): its price, the spend that paid it and its place in the
// customer's history. The run and its result are the run log's; deleting hides this row only.
model AiCustomerResult {
  runId           String    @id @map("run_id") @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  // recommendations | marketing | brand_content | image
  tool            String
  credits         Int
  spendId         String    @map("spend_id") @db.Uuid
  // The image a refinement was made from.
  parentId        String?   @map("parent_id") @db.Uuid
  // The image an image run made, set when it finishes.
  fileId          String?   @map("file_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run         AiRun              @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: NoAction)
  customer    Customer           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  spend       CreditSpend        @relation(fields: [tenantId, spendId], references: [tenantId, id], onDelete: NoAction)
  parent      AiCustomerResult?  @relation("ai_refinement", fields: [tenantId, parentId], references: [tenantId, runId], onDelete: NoAction)
  refinements AiCustomerResult[] @relation("ai_refinement")
  file        File?              @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)
  createdBy   User               @relation("ai_customer_result_created_by", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  deletedBy   User?              @relation("ai_customer_result_deleted_by", fields: [tenantId, deletedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, runId])
  @@unique([tenantId, spendId])
  @@index([tenantId, customerId, runId])
  @@map("ai_customer_result")
}

// A customer's brand (AI 2 spec, goals 8–9): context for its AI tools, given to the model as data.
model AiBrandProfile {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  name            String
  sells           String
  audience        String
  tone            String
  notes           String   @default("")
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  updatedBy User     @relation(fields: [tenantId, updatedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, customerId])
  @@map("ai_brand_profile")
}

// ---------------------------------------------------------------------------
// Reporting (AI 1 spec, goal 4). Read models: rewritten by the `reports.refresh`
// job, never by a client (D63).
// ---------------------------------------------------------------------------

// One ISO week's dashboard numbers, from its Monday in the workspace's time zone.
model ReportWeek {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  weekStart  DateTime @map("week_start") @db.Date
  // Validated by weekMetricsSchema (src/modules/reporting/week-metrics.ts) on write and on read.
  data       Json
  computedAt DateTime @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekStart])
  @@map("report_week")
}

// One export a staff member asked for (Reporting 2 spec): built by a job from the permissions held when
// asked, downloaded only by whoever asked, its file removed after 30 days; the row stays as the log.
model ReportExport {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // EXPORT_KINDS in src/modules/reporting/exports/export-kinds.ts
  kind              String
  // Validated by the kind's parameter schema.
  params            Json
  // The asker's permissions when asked; the file is built from these, never from the current role.
  permissions       String[]
  // pending | ready | failed | expired
  status            String    @default("pending")
  rows              Int?
  fileId            String?   @map("file_id") @db.Uuid
  error             String?
  // Null for a scheduled export, which nobody asked for (Orders 3 spec, goal 10).
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  // `<schedule kind>:<YYYY-MM>` for a scheduled export, so each is made once per month.
  scheduleKey       String?   @map("schedule_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  finishedAt        DateTime? @map("finished_at")
  // When a download link was first issued.
  downloadedAt      DateTime? @map("downloaded_at")
  // 30 days after it was ready; the file is removed then.
  expiresAt         DateTime? @map("expires_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file        File?  @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)
  requestedBy User?  @relation(fields: [tenantId, requestedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@unique([tenantId, scheduleKey])
  @@index([tenantId, requestedByUserId, id])
  @@index([tenantId, status, expiresAt])
  @@map("report_export")
}

// ---------------------------------------------------------------------------
// The knowledge base (AI 1 spec, goal 14). Postgres is the source of truth; the
// vector store's passages are derived from published articles and rebuilt by
// `npm run knowledge:reindex`.
// ---------------------------------------------------------------------------

// An article staff write in the ERP: how things are done.
model KnowledgeArticle {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  title           String
  // Markdown.
  body            String
  tags            String[]
  // draft | published | archived
  status          String   @default("draft")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  attachments KnowledgeAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("knowledge_article")
}

// A PDF or plain text file attached to an article; its text is indexed with the article.
model KnowledgeAttachment {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  // From 0, in the order given.
  position  Int

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article KnowledgeArticle @relation(fields: [tenantId, articleId], references: [tenantId, id], onDelete: Cascade)
  file    File             @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, articleId, fileId])
  @@index([tenantId, fileId])
  @@map("knowledge_attachment")
}
