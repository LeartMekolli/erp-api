// Prisma 7: the datasource carries no connection URL. Migrate reads its URL
// from prisma.config.ts, and the client is constructed with a driver adapter.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // The project is CommonJS (no "type": "module"), and ts-jest compiles to CJS.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  // uuid(7) is generated by Prisma Client, not the database, so ids stay
  // application-generated and time-ordered as ADR 0004 requires.
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  status          String   @default("active")
  defaultCurrency String   @map("default_currency") @db.Char(3)
  defaultLocale   String   @map("default_locale")
  timezone        String
  // The workspace's customer site, such as https://shop.example: customer emails link there and
  // it may call the API (Customers spec, goal 13). Platform-level, so CORS can read it per request.
  customerSiteOrigin String? @map("customer_site_origin")
  createdAt       DateTime @default(now()) @map("created_at")

  settings        TenantSetting[]
  users           User[]
  roles           Role[]
  serviceAccounts ServiceAccount[]
  idempotencyKeys IdempotencyKey[]
  notifications   Notification[]
  notificationTemplates NotificationTemplate[]
  files           File[]
  units           Unit[]
  materials       Material[]
  optionGroups    OptionGroup[]
  optionValues    OptionValue[]
  optionRules     OptionRule[]
  optionRuleTargets OptionRuleTarget[]
  categories      Category[]
  products        Product[]
  productOptionGroups ProductOptionGroup[]
  productOptionValues ProductOptionValue[]
  stepTypes       StepType[]
  pricingProfile  PricingProfile?
  categorySteps   CategoryStep[]
  productChains   ProductChain[]
  productSteps    ProductStep[]
  optionStepEffects OptionStepEffect[]
  stepPrices      StepPrice[]
  marginOverrides MarginOverride[]
  discountTiers   DiscountTier[]
  customerGroups  CustomerGroup[]
  deliverySpeeds  DeliverySpeed[]
  minSizeSurcharges MinSizeSurcharge[]
  quotes          Quote[]
  customers       Customer[]
  customerInvitations CustomerInvitation[]
  defects         Defect[]
  workflows       Workflow[]
  workflowVersions WorkflowVersion[]
  workflowSteps   WorkflowStep[]
  workOrderGroups WorkOrderGroup[]
  workOrders      WorkOrder[]
  transitions     Transition[]
  transitionAnswers TransitionAnswer[]
  transitionPhotos TransitionPhoto[]
  partners        Partner[]
  partnerInvitations PartnerInvitation[]
  partnerCapabilities PartnerCapability[]
  partnerClosedPeriods PartnerClosedPeriod[]
  partnerOfferings PartnerOffering[]
  partnerStepPrices PartnerStepPrice[]
  jobAssignments  JobAssignment[]

  @@map("tenant")
}

// ---------------------------------------------------------------------------
// Identity (spec section 4). Every model below except PlatformAdmin is
// tenant-owned and follows src/database/rls.sql.md. Child tables reach the
// tenant through a composite foreign key (tenant_id, x_id) -> (tenant_id, id):
// foreign-key checks bypass row-level security, so a plain key would accept
// another tenant's id. Emails are stored trimmed and lowercased.
// ---------------------------------------------------------------------------

/// Platform-owned: acts across tenants through platform endpoints (ADR 0001).
model PlatformAdmin {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_admin")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  status       String   @default("active")
  locale       String
  // staff | customer | partner: customer and partner people hold memberships of their own kind, never workspace roles
  kind         String   @default("staff")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  memberships    OrganisationMembership[]
  notifications  NotificationRecipient[]
  files          File[]
  fileVersions   FileVersion[]
  externalIdentities ExternalIdentity[]
  transitions    Transition[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@map("app_user")
}

model Role {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]
  invitations Invitation[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("role")
}

model RolePermission {
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permission")
}

model UserRole {
  tenantId String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

/// One row per issued refresh token; a family is one login's rotation chain (F2, F3).
model RefreshToken {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  familyId      String    @map("family_id") @db.Uuid
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  issuedAt      DateTime  @default(now()) @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  // rotated | reuse_detected | logout | password_reset
  revokedReason String?   @map("revoked_reason")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token")
}

model Invitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  email           String
  roleId          String    @map("role_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  // Null when a platform admin invited the tenant's owner.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  role Role @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, email])
  @@map("invitation")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset")
}

/// A user's membership in a partner or customer organisation (D44, D56). The
/// organisation tables arrive with their modules; organisation_id gets its
/// foreign key then.
model OrganisationMembership {
  id               String @id @default(uuid(7)) @db.Uuid
  tenantId         String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  userId           String @map("user_id") @db.Uuid
  // partner | customer
  organisationType String @map("organisation_type")
  organisationId   String @map("organisation_id") @db.Uuid
  role             String

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([userId, organisationType, organisationId])
  @@map("organisation_membership")
}

/// A sign-in account at an outside provider, linked to a user by the
/// provider's stable subject id, never by email (Customers spec, goal 4).
model ExternalIdentity {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // google
  provider  String
  subject   String
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, provider, subject])
  @@index([tenantId, userId])
  @@map("external_identity")
}

/// Modelled now; keys are issued with order intake (Q7).
model ServiceAccount {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name      String
  keyHash   String   @unique @map("key_hash")
  scopes    String[]
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("service_account")
}

/// Append-only (ADR 0003, F8). No foreign keys, deliberately: entries outlive
/// the rows they describe, the tenant included, and a cascading delete would be
/// refused by the append-only trigger anyway.
model AuditEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // user | platform_admin | system
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id") @db.Uuid
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_entry")
}

model TenantSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  // Filled from the transaction's tenant (PrismaService.inTenant), so callers
  // never pass it. Every tenant-owned table carries this default.
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_setting")
}

// ---------------------------------------------------------------------------
// Jobs and idempotency (spec section 7, ADR 0005).
// ---------------------------------------------------------------------------

/// A client's Idempotency-Key on a tenant POST, with the response it got, so
/// a retry replays it instead of acting twice. Deleted after 30 days.
model IdempotencyKey {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key            String
  // sha256 of user, method, path and canonical body
  fingerprint    String    @db.Char(64)
  // in_progress | completed
  status         String
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, createdAt])
  @@map("idempotency_key")
}

// ---------------------------------------------------------------------------
// Notifications (spec section 6). Domain code raises a notification; the
// worker fans it out to the in-app feed and to email, one delivery row per
// attempt.
// ---------------------------------------------------------------------------

/// One raised event. `payload` holds the template variables except secrets,
/// which are sealed in `secrets` and wiped once sent (plan N2). Claimed by the
/// dispatch job: pending -> dispatching -> dispatched, or failed.
model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  eventKey    String    @map("event_key")
  // invitee | user | permission
  audience    String
  subjectType String    @map("subject_type")
  subjectId   String    @map("subject_id") @db.Uuid
  payload     Json
  secrets     Bytes?
  status      String
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("notification")
}

/// The in-app feed: one row per user a notification reached, with the title
/// and body rendered at dispatch (plan N6).
model NotificationRecipient {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  notificationId String    @map("notification_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String
  body           String
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)
  user         User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([tenantId, userId, id])
  @@map("notification_recipient")
}

/// A tenant's override of a repo template (D69). Repo templates stay the
/// defaults; `enabled: false` falls back to them.
model NotificationTemplate {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  eventKey        String   @map("event_key")
  locale          String
  subject         String
  body            String
  enabled         Boolean  @default(true)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventKey, locale])
  @@map("notification_template")
}

/// Append-only (ADR 0003): one row per delivery attempt. No foreign keys, as
/// with audit_entry: the log outlives what it describes.
model NotificationDelivery {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  // email
  channel        String
  target         String
  // sent | failed
  status         String
  attempt        Int
  providerId     String?  @map("provider_id")
  error          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, notificationId])
  @@map("notification_delivery")
}

// ---------------------------------------------------------------------------
// Files (spec section 5). Bytes live in private object storage under
// <tenant_id>/<file_id>/<version_id>; these tables hold what is known about
// them. Who created or uploaded a file is a real user of the same tenant: the
// uploader is notified when measurement finishes. Those two keys are
// DEFERRABLE INITIALLY DEFERRED in the migration (Prisma cannot express it), so
// a tenant delete can remove users and files in the same transaction.
// ---------------------------------------------------------------------------

model File {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // design | image | document | other
  kind            String
  name            String
  // mm | cm | m | in; meshes carry none (Q4)
  declaredUnit    String?  @map("declared_unit")
  // Set by the module that attaches the file; none ships with the foundation.
  ownerType       String?  @map("owner_type")
  ownerId         String?  @map("owner_id") @db.Uuid
  // active
  status          String   @default("active")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: NoAction)
  versions  FileVersion[]

  @@unique([tenantId, id])
  @@index([tenantId, ownerType, ownerId])
  @@map("file")
}

/// One uploaded version. Claimed by the measurement job (rule A1):
/// pending -> completing -> uploaded -> measuring -> measured, or failed after
/// the last attempt. `completing` is the claim held while an upload is copied
/// to its final key.
model FileVersion {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  fileId           String    @map("file_id") @db.Uuid
  number           Int
  storageKey       String    @unique @map("storage_key")
  // Used only for the download's Content-Disposition, never in a storage key.
  originalName     String    @map("original_name")
  contentType      String    @map("content_type")
  size             BigInt
  // SHA-256 in hex, computed by the measurement job.
  checksum         String?   @db.Char(64)
  status           String    @default("pending")
  claimedAt        DateTime? @map("claimed_at")
  uploadedByUserId String    @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")

  file       File      @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [tenantId, uploadedByUserId], references: [tenantId, id], onDelete: NoAction)
  measures   Measure[]
  products   Product[]
  sopForSteps WorkflowStep[]
  workOrderGroups WorkOrderGroup[]
  transitionPhotos TransitionPhoto[]
  partnerAgreements Partner[]

  @@unique([fileId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@map("file_version")
}

/// What a measurer found in a version (D60, Q4): one value per measure type.
model Measure {
  id            String  @id @default(uuid(7)) @db.Uuid
  tenantId      String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  fileVersionId String  @map("file_version_id") @db.Uuid
  type          String
  value         Decimal @db.Decimal(18, 6)
  unit          String

  version FileVersion @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([fileVersionId, type])
  @@index([tenantId])
  @@map("measure")
}

// Catalog (spec 2026-10-22). Seeded units live in code (units.ts); a tenant's own are here.
model Unit {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  // mass | volume | area | length | count
  dimension String
  // Base units of the dimension per one of this unit.
  factor    Decimal  @db.Decimal(18, 9)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("unit")
}

// A material a step consumes, with its price source (Catalog spec C5, B6, B7).
model Material {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key              String
  name             String
  // A unit key (seeded or the tenant's) of dimension mass, volume or count.
  pricedUnit       String    @map("priced_unit")
  densityGCm3      Decimal?  @map("density_g_cm3") @db.Decimal(18, 6)
  // feed | manual
  priceSource      String    @map("price_source")
  // The price provider's metal key, such as silver.
  feedMetal        String?   @map("feed_metal")
  addonPercent     Decimal   @default(0) @map("addon_percent") @db.Decimal(9, 4)
  addonAmount      Decimal   @default(0) @map("addon_amount") @db.Decimal(18, 6)
  manualPrice      Decimal?  @map("manual_price") @db.Decimal(18, 6)
  fallbackPrice    Decimal?  @map("fallback_price") @db.Decimal(18, 6)
  // Every price above, and the override, is in this currency.
  currency         String    @db.Char(3)
  overridePrice    Decimal?  @map("override_price") @db.Decimal(18, 6)
  overrideReason   String?   @map("override_reason")
  overrideAt       DateTime? @map("override_at")
  overrideByUserId String?   @map("override_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionValues OptionValue[]
  products     Product[]
  stepPrices   StepPrice[]
  partnerPrices PartnerStepPrice[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("material")
}

// Daily metal prices from the price provider (Catalog spec C5, D87). Platform
// data, not tenant-owned: one fetch per currency serves every tenant.
model MetalPriceSnapshot {
  id           String   @id @default(uuid(7)) @db.Uuid
  provider     String
  metal        String
  currency     String   @db.Char(3)
  pricePerGram Decimal  @map("price_per_gram") @db.Decimal(18, 9)
  fetchedAt    DateTime @map("fetched_at")

  @@index([metal, currency, fetchedAt(sort: Desc)])
  @@map("metal_price_snapshot")
}

// A configurable dimension of a product, such as material or finish (Catalog spec C4).
model OptionGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values        OptionValue[]
  productGroups ProductOptionGroup[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("option_group")
}

// One choice within a group. Choosing it may select a material (the catalog's option effect).
model OptionValue {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  key        String
  name       String
  materialId String?  @map("material_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       OptionGroup        @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  material    Material?          @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction)
  rules       OptionRule[]
  ruleTargets OptionRuleTarget[]
  productDefaults ProductOptionGroup[]
  productOffers   ProductOptionValue[]
  stepEffects     OptionStepEffect[]
  partnerOfferings PartnerOffering[]

  @@unique([groupId, key])
  @@unique([tenantId, id])
  @@map("option_value")
}

// excludes: choosing the value rules out every target. requires: it needs at least one target (spec C4, B9).
model OptionRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  // excludes | requires
  kind      String
  valueId   String   @map("value_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value   OptionValue        @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)
  targets OptionRuleTarget[]

  @@unique([tenantId, id])
  @@index([tenantId, valueId])
  @@map("option_rule")
}

model OptionRuleTarget {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  ruleId   String @map("rule_id") @db.Uuid
  valueId  String @map("value_id") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule   OptionRule  @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Cascade)
  value  OptionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([ruleId, valueId])
  @@index([tenantId])
  @@map("option_rule_target")
}

// Groups products and names the measures a design file must have (Catalog spec, B1).
model Category {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key              String
  name             String
  // A subset of MEASURE_TYPES in src/modules/files/measurers.ts.
  requiredMeasures String[] @map("required_measures")
  // The workflow its products go through, unless a product has its own (D33).
  workflowId       String?  @map("workflow_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow?      @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: NoAction)
  products Product[]
  steps    CategoryStep[]
  margin   MarginOverride?
  minSizeSurcharges MinSizeSurcharge[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("category")
}

// custom: the customer brings the design file; ready_made: the product pins its own measured version (C2, B1).
model Product {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  key           String
  name          String
  // custom | ready_made
  kind          String
  fileVersionId String?  @map("file_version_id") @db.Uuid
  // A material the product fixes, instead of one chosen through an option (B11).
  materialId    String?  @map("material_id") @db.Uuid
  // { mode: none } | { mode: range, min, max } | { mode: named, sizes: [{ key, scale }] }, scales as decimal strings (C3).
  sizing        Json
  // active
  status        String   @default("active")
  // Customers see a product only once staff publish it (Customers spec, goal 11).
  published     Boolean  @default(false)
  // Set for a customer's private product; null for the shared catalog (goal 7).
  customerId    String?  @map("customer_id") @db.Uuid
  // Replaces its category's workflow when set (D33).
  workflowId    String?  @map("workflow_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category             @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction)
  workflow     Workflow?            @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: NoAction)
  customer     Customer?            @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  fileVersion  FileVersion?         @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)
  material     Material?            @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: NoAction)
  optionGroups ProductOptionGroup[]
  optionValues ProductOptionValue[]
  chain        ProductChain?
  quotes       Quote[]
  workOrderGroups WorkOrderGroup[]
  steps        ProductStep[]
  margin       MarginOverride?

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("product")
}

// An option group a product offers, whether it must be answered, and its default (C4, B10).
model ProductOptionGroup {
  id             String  @id @default(uuid(7)) @db.Uuid
  tenantId       String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  groupId        String  @map("group_id") @db.Uuid
  required       Boolean
  defaultValueId String? @map("default_value_id") @db.Uuid
  position       Int

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  group        OptionGroup  @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  defaultValue OptionValue? @relation(fields: [tenantId, defaultValueId], references: [tenantId, id], onDelete: NoAction)

  @@unique([productId, groupId])
  @@index([tenantId])
  @@map("product_option_group")
}

// An option value a product allows.
model ProductOptionValue {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  valueId   String @map("value_id") @db.Uuid

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  value   OptionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([productId, valueId])
  @@index([tenantId])
  @@map("product_option_value")
}

// A kind of production operation, as workspace configuration (Pricing spec). The summary group
// places its cost in the customer summary: material | making | finishing.
model StepType {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key          String
  name         String
  // Orders the steps of a chain.
  position     Int
  // material | making | finishing; null for a step nobody prices (final QC, packing), never in a chain or priced.
  summaryGroup String?  @map("summary_group")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categorySteps CategoryStep[]
  productSteps  ProductStep[]
  optionEffects OptionStepEffect[]
  prices        StepPrice[]
  workflowSteps WorkflowStep[]
  partnerCapabilities PartnerCapability[]
  partnerPrices PartnerStepPrice[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("step_type")
}

// The workspace's pricing defaults; absent until first set, and read as the defaults below.
model PricingProfile {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @unique @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  marginPercent    Decimal  @default(0) @map("margin_percent") @db.Decimal(9, 4)
  overheadPerPiece Decimal  @default(0) @map("overhead_per_piece") @db.Decimal(18, 6)
  quoteValidDays   Int      @default(7) @map("quote_valid_days")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("pricing_profile")
}

// The usual chain of steps for a category's products (Pricing spec R4).
model CategoryStep {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  stepTypeId String @map("step_type_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([categoryId, stepTypeId])
  @@index([tenantId])
  @@map("category_step")
}

// Present when a product replaces its category's chain with its own (which may be empty).
model ProductChain {
  id        String @id @default(uuid(7)) @db.Uuid
  tenantId  String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId String @unique @map("product_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  // One-to-one through the tenant-scoped key needs it unique; `product_id` alone stays unique for upserts.
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@map("product_chain")
}

model ProductStep {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  stepTypeId String @map("step_type_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([productId, stepTypeId])
  @@index([tenantId])
  @@map("product_step")
}

// Choosing the value adds or removes the step (the option effect on steps, Pricing spec R4).
model OptionStepEffect {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  valueId    String @map("value_id") @db.Uuid
  stepTypeId String @map("step_type_id") @db.Uuid
  // add | remove
  effect     String

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  value    OptionValue @relation(fields: [tenantId, valueId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType    @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([valueId, stepTypeId])
  @@index([tenantId])
  @@map("option_step_effect")
}

// What a step costs, from typed building blocks (Pricing spec, Q2). With a material, the price for
// that material only; without, the step's default. Saves lock the step type, so a step has at most
// one default even though Postgres treats the null material_id as distinct.
model StepPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  materialId     String?  @map("material_id") @db.Uuid
  failurePercent Decimal  @map("failure_percent") @db.Decimal(9, 4)
  // Validated by blocksSchema (src/modules/pricing/blocks.ts) on every save.
  blocks         Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stepType StepType  @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)
  material Material? @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, stepTypeId, materialId])
  @@index([tenantId])
  @@map("step_price")
}

// A category's or a product's own margin instead of the pricing profile's (Pricing spec, Q5).
// Exactly one of category_id and product_id is set (a CHECK in the migration).
model MarginOverride {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId    String?  @unique @map("category_id") @db.Uuid
  productId     String?  @unique @map("product_id") @db.Uuid
  marginPercent Decimal  @map("margin_percent") @db.Decimal(9, 4)
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  product  Product?  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, categoryId])
  @@unique([tenantId, productId])
  @@index([tenantId])
  @@map("margin_override")
}

// From `min_quantity` pieces on, `percent` off; the highest tier reached applies (P6).
model DiscountTier {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  minQuantity Int     @map("min_quantity")
  percent     Decimal @db.Decimal(9, 4)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, minQuantity])
  @@index([tenantId])
  @@map("discount_tier")
}

// A markup (positive) or discount (negative) for a group of customers (D45).
model CustomerGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  percent   Decimal  @db.Decimal(9, 4)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("customer_group")
}

// Standard, express, rush...: a surcharge on the price (Q11). Saves take a per-tenant advisory
// lock, so at most one speed is the default.
model DeliverySpeed {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key              String
  name             String
  surchargePercent Decimal  @map("surcharge_percent") @db.Decimal(9, 4)
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("delivery_speed")
}

// A fixed amount per piece when a measure of the scaled design is below `below` `unit` (P7).
// Without a category it applies to every category.
model MinSizeSurcharge {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  categoryId String?  @map("category_id") @db.Uuid
  measure    String
  below      Decimal  @db.Decimal(18, 6)
  // A catalog unit key of the measure's dimension.
  unit       String
  amount     Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@map("min_size_surcharge")
}

// A saved price for a configuration, held until it expires (Pricing spec). Everything is copied in,
// never re-read: later price changes do not move it.
model Quote {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int
  currency        String   @db.Char(3)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 2)
  total           Decimal  @db.Decimal(18, 2)
  // Options, size, file version, customer group and delivery speed as requested and resolved.
  inputs          Json
  // Every material priced, with its price, source and staleness at quote time.
  materials       Json
  breakdown       Json
  summary         Json
  expiresAt       DateTime @map("expires_at")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  // The customer the quote is for, which sees it in the portal; null for an internal quote.
  customerId      String?  @map("customer_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // A quoted product is kept: a saved quote outlives changes to the catalog.
  product  Product   @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction)
  customer Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@map("quote")
}

// A customer organisation: a brand, or one person on their own (Customers spec, D44).
model Customer {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name            String
  // active | disabled: a disabled customer's people cannot act for it
  status          String   @default("active")
  customerGroupId String?  @map("customer_group_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup?       @relation(fields: [tenantId, customerGroupId], references: [tenantId, id], onDelete: NoAction)
  invitations   CustomerInvitation[]
  products      Product[]
  quotes        Quote[]
  workOrderGroups WorkOrderGroup[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("customer")
}

// An invitation to act for a customer with a role. Accepting creates the customer person, or adds a
// membership when the email already belongs to one (Customers spec, goals 2–3).
model CustomerInvitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  // Lowercased.
  email           String
  // owner | admin | buyer | viewer
  role            String
  tokenHash       String    @unique @map("token_hash")
  // A staff user or a customer person; null when seeded.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId, email])
  @@map("customer_invitation")
}

// ---------------------------------------------------------------------------
// Workflow/QC (docs/superpowers/specs/2026-10-23-workflow-qc-design.md).
// ---------------------------------------------------------------------------

// A catalogued failure reason recorded on a transition (D38). Never deleted, since transitions
// point at it; an inactive defect can't be added to a workflow step.
model Defect {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transitions Transition[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("defect")
}

// An ordered list of checked steps, assigned on a category and overridable per product (D33).
model Workflow {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  key       String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions   WorkflowVersion[]
  categories Category[]
  products   Product[]

  @@unique([tenantId, key])
  @@unique([tenantId, id])
  @@map("workflow")
}

// One immutable version of a workflow's steps (D34). Editing the steps adds the next number; the
// latest is the current one.
model WorkflowVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  workflowId      String   @map("workflow_id") @db.Uuid
  number          Int
  // Null when seeded.
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  // The partner step whose pass makes the partner owed; null means the last partner step
  // (src/modules/workflow/partner-steps.ts).
  payoutStepId    String?  @map("payout_step_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow   Workflow       @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  steps      WorkflowStep[] @relation("VersionSteps")
  payoutStep WorkflowStep?  @relation("VersionPayoutStep", fields: [tenantId, payoutStepId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)
  groups     WorkOrderGroup[]

  @@unique([tenantId, workflowId, number])
  @@unique([tenantId, id])
  @@map("workflow_version")
}

// A step of one workflow version, never changed. `config` holds the checklist, defects, rework
// targets, photo and comment rules and the customer view (src/modules/workflow/workflow-config.ts).
model WorkflowStep {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  versionId        String   @map("version_id") @db.Uuid
  // From 0, in the order pieces go through the steps.
  position         Int
  key              String
  name             String
  stepTypeId       String   @map("step_type_id") @db.Uuid
  // Whether the step type was priced when this version was made. Paths read this, never the step type,
  // so changing a step type later can't reroute pieces already running on the version.
  priced           Boolean
  // partner | workspace: a partner's step, or one the workspace does in-house (Partners spec, goal 7)
  doneBy           String   @default("partner") @map("done_by")
  config           Json
  sopFileVersionId String?  @map("sop_file_version_id") @db.Uuid
  expectedMinutes  Decimal? @map("expected_minutes") @db.Decimal(9, 2)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version        WorkflowVersion @relation("VersionSteps", fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  payoutOf       WorkflowVersion[] @relation("VersionPayoutStep")
  stepType       StepType        @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: NoAction)
  sopFileVersion FileVersion?    @relation(fields: [tenantId, sopFileVersionId], references: [tenantId, id], onDelete: NoAction)
  workOrders     WorkOrder[]
  transitionsFrom Transition[] @relation("TransitionFrom")
  transitionsTo   Transition[] @relation("TransitionTo")

  @@unique([versionId, key])
  @@unique([versionId, position])
  @@unique([tenantId, id])
  @@map("workflow_step")
}

// The pieces started together from one source (a quote now, an order line later), all on one
// workflow version (D34). Its progress is derived from its work orders, never stored (D39).
model WorkOrderGroup {
  id                String   @id @default(uuid(7)) @db.Uuid
  tenantId          String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  workflowVersionId String   @map("workflow_version_id") @db.Uuid
  // quote | order_line
  sourceType        String   @map("source_type")
  sourceId          String   @map("source_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  fileVersionId     String?  @map("file_version_id") @db.Uuid
  customerId        String?  @map("customer_id") @db.Uuid
  // How many good pieces the group must deliver.
  quantity          Int
  // The step types the source priced, which decide the priced steps on the path; null: every step runs.
  chainStepTypeIds  Json?    @map("chain_step_type_ids")
  createdByUserId   String   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowVersion WorkflowVersion @relation(fields: [tenantId, workflowVersionId], references: [tenantId, id], onDelete: NoAction)
  product         Product?        @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: NoAction)
  fileVersion     FileVersion?    @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)
  customer        Customer?       @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: NoAction)
  workOrders      WorkOrder[]
  assignments     JobAssignment[]

  @@unique([tenantId, sourceType, sourceId])
  @@unique([tenantId, id])
  @@map("work_order_group")
}

// One piece (serial tracking, F3). `currentStepId` is set exactly while the piece is active.
model WorkOrder {
  // Given in number order when a group starts, so a list by id lists pieces 1, 2, 3...
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId       String   @map("group_id") @db.Uuid
  // 1..quantity; a replacement keeps the number of the piece it replaces.
  number        Int
  // active | finished | scrapped | cancelled
  status        String   @default("active")
  currentStepId String?  @map("current_step_id") @db.Uuid
  replacesId    String?  @map("replaces_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group       WorkOrderGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  currentStep WorkflowStep?  @relation(fields: [tenantId, currentStepId], references: [tenantId, id], onDelete: NoAction)
  replaces    WorkOrder?     @relation("Replacement", fields: [tenantId, replacesId], references: [tenantId, id], onDelete: NoAction)
  // Several only when a restored piece is scrapped again; at most one is ever active.
  replacements WorkOrder[]   @relation("Replacement")
  transitions  Transition[]

  @@unique([tenantId, id])
  @@index([tenantId, replacesId])
  @@index([tenantId, currentStepId])
  @@index([groupId, number])
  @@map("work_order")
}

// One move of one piece (D37, ADR 0003): append-only, written only by the move command. The from-step
// and from-status are read from the piece, never sent by the client (D35). A correction is a new row.
model Transition {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  workOrderId    String   @map("work_order_id") @db.Uuid
  // pass | fail | correction
  kind           String
  // rework | scrap | continue on a fail; null otherwise
  outcome        String?
  // Null when the piece wasn't at a step (finished, scrapped) or didn't land on one.
  fromStepId     String?  @map("from_step_id") @db.Uuid
  toStepId       String?  @map("to_step_id") @db.Uuid
  fromStatus     String   @map("from_status")
  toStatus       String   @map("to_status")
  defectId       String?  @map("defect_id") @db.Uuid
  // Why the defect's default outcome or rework target was not followed (D38).
  overrideReason String?  @map("override_reason")
  comment        String?
  actorUserId    String   @map("actor_user_id") @db.Uuid
  // The partner the move counts for: the job's accepted partner, at a partner step; null otherwise
  // (Partners spec, B5). Whoever made it, staff or the partner's own people.
  partnerId      String?  @map("partner_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NoAction: a piece with history can't be deleted; only deleting the workspace removes both.
  workOrder WorkOrder        @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: NoAction)
  partner   Partner?         @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)
  fromStep  WorkflowStep?    @relation("TransitionFrom", fields: [tenantId, fromStepId], references: [tenantId, id], onDelete: NoAction)
  toStep    WorkflowStep?    @relation("TransitionTo", fields: [tenantId, toStepId], references: [tenantId, id], onDelete: NoAction)
  defect    Defect?          @relation(fields: [tenantId, defectId], references: [tenantId, id], onDelete: NoAction)
  actor     User             @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction)
  answers   TransitionAnswer[]
  photos    TransitionPhoto[]

  @@unique([tenantId, id])
  @@index([tenantId, workOrderId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, fromStepId])
  @@index([tenantId, toStepId])
  @@index([tenantId, defectId])
  @@index([tenantId, actorUserId])
  @@index([tenantId, partnerId])
  @@map("transition")
}

// A checklist answer given with a move, as it was given: one row per item and transition.
model TransitionAnswer {
  id           String  @id @default(uuid(7)) @db.Uuid
  tenantId     String  @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  transitionId String  @map("transition_id") @db.Uuid
  itemKey      String  @map("item_key")
  // A choice's option key, a decimal, text, or true/false for a yes/no question.
  value        String
  note         String?
  // Whether the answer met the item's check when it was given.
  passing      Boolean

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transition Transition @relation(fields: [tenantId, transitionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, transitionId])
  @@map("transition_answer")
}

model TransitionPhoto {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  transitionId  String @map("transition_id") @db.Uuid
  fileVersionId String @map("file_version_id") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transition  Transition  @relation(fields: [tenantId, transitionId], references: [tenantId, id], onDelete: Cascade)
  fileVersion FileVersion @relation(fields: [tenantId, fileVersionId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, transitionId])
  @@index([tenantId, fileVersionId])
  @@map("transition_photo")
}

// ---------------------------------------------------------------------------
// Partners (Partners spec): outside workshops that make the pieces.

// A partner workshop. Its people are users with partner memberships (organisation_membership,
// organisation_type = 'partner'), as customers' people are.
model Partner {
  id                      String    @id @default(uuid(7)) @db.Uuid
  tenantId                String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  name                    String
  // What customers see when they may pick a workshop.
  displayName             String    @map("display_name")
  // setting_up | approved | suspended: only approved partners are offered jobs
  status                  String    @default("setting_up")
  // Takes any job a customer sends it directly, without an offer (goal 11).
  acceptsDirectOrders     Boolean   @default(false) @map("accepts_direct_orders")
  agreementFileVersionId  String?   @map("agreement_file_version_id") @db.Uuid
  agreementSignedOn       DateTime? @map("agreement_signed_on") @db.Date
  // Jobs offered or accepted at once; null for no limit.
  maxOpenJobs             Int?      @map("max_open_jobs")
  // When the partner's owner said its setup is ready for approval (goal 17); set once.
  submittedAt             DateTime? @map("submitted_at")
  createdAt               DateTime  @default(now()) @map("created_at")

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agreementVersion FileVersion?          @relation(fields: [tenantId, agreementFileVersionId], references: [tenantId, id], onDelete: NoAction)
  invitations      PartnerInvitation[]
  capabilities     PartnerCapability[]
  closedPeriods    PartnerClosedPeriod[]
  offerings        PartnerOffering[]
  stepPrices       PartnerStepPrice[]
  assignments      JobAssignment[]
  transitions      Transition[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("partner")
}

// An invitation to act for a partner with a role. Accepting creates the partner person, or adds a
// membership when the email already belongs to one (Partners spec, goal 1).
model PartnerInvitation {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId       String    @map("partner_id") @db.Uuid
  // Lowercased.
  email           String
  // owner | admin | member
  role            String
  tokenHash       String    @unique @map("token_hash")
  // A staff user or a partner person.
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, partnerId, email])
  @@map("partner_invitation")
}

// A step type a partner can do, within limits, and how many pieces it can take per period (goals 4, 5).
model PartnerCapability {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  // Pieces per job.
  minQuantity    Int      @default(1) @map("min_quantity")
  maxQuantity    Int?     @map("max_quantity")
  // The largest side of a piece's bounding box.
  maxSizeMm      Decimal? @map("max_size_mm") @db.Decimal(18, 6)
  // Pieces per capacity period.
  capacity       Int
  // day | week
  capacityPeriod String   @map("capacity_period")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner  Partner  @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: NoAction)

  @@unique([partnerId, stepTypeId])
  @@index([tenantId, partnerId])
  @@index([tenantId, stepTypeId])
  @@map("partner_capability")
}

// Days a partner takes no work, both ends included (goal 5).
model PartnerClosedPeriod {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  note      String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, partnerId])
  @@map("partner_closed_period")
}

// An option value a partner works with: it is only offered jobs whose values it all offers (goal 6).
model PartnerOffering {
  id            String @id @default(uuid(7)) @db.Uuid
  tenantId      String @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId     String @map("partner_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner     Partner     @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  optionValue OptionValue @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([partnerId, optionValueId])
  @@index([tenantId, partnerId])
  @@index([tenantId, optionValueId])
  @@map("partner_offering")
}

// A partner's price for a step, as a workspace step price: for one material or as the step's default
// (goal 8). Saves lock the partner row, so two defaults for a step can't be written side by side.
model PartnerStepPrice {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  partnerId      String   @map("partner_id") @db.Uuid
  stepTypeId     String   @map("step_type_id") @db.Uuid
  materialId     String?  @map("material_id") @db.Uuid
  failurePercent Decimal  @map("failure_percent") @db.Decimal(9, 4)
  // Validated by blocksSchema (src/modules/pricing/blocks.ts) on every save.
  blocks         Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner  Partner   @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: Cascade)
  stepType StepType  @relation(fields: [tenantId, stepTypeId], references: [tenantId, id], onDelete: Cascade)
  material Material? @relation(fields: [tenantId, materialId], references: [tenantId, id], onDelete: Cascade)

  @@unique([partnerId, stepTypeId, materialId])
  @@index([tenantId, partnerId])
  @@index([tenantId, stepTypeId])
  @@index([tenantId, materialId])
  @@map("partner_step_price")
}

// A job (a work order group) handed to a partner: an offer, a direct send, or a reassignment (goals 10,
// 11, P16). Every row is kept as history. At most one row per group is `offered` or `accepted`, which
// writes keep under a lock on the group row.
model JobAssignment {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @default(dbgenerated("(current_setting('app.current_tenant_id'::text))::uuid")) @map("tenant_id") @db.Uuid
  groupId            String    @map("group_id") @db.Uuid
  partnerId          String    @map("partner_id") @db.Uuid
  // offer | direct | reassign
  kind               String
  // offered | accepted | declined | expired | withdrawn | replaced
  status             String
  // What the partner is paid for the job, frozen when it is handed over.
  cost               Decimal   @db.Decimal(18, 2)
  // Set by staff instead of `cost`, with a reason, such as for a partner replaced mid-way (P16).
  owedOverride       Decimal?  @map("owed_override") @db.Decimal(18, 2)
  owedOverrideReason String?   @map("owed_override_reason")
  // When an offer lapses; null for a job handed over without an offer.
  expiresAt          DateTime? @map("expires_at")
  respondedAt        DateTime? @map("responded_at")
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group   WorkOrderGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  partner Partner        @relation(fields: [tenantId, partnerId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, groupId])
  @@index([tenantId, partnerId, status])
  @@index([status, expiresAt])
  @@map("job_assignment")
}
