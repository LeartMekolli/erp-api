# Copy to .env. Values below match docker-compose.yml.

NODE_ENV=development
PORT=3000

# The application connects as erp_app, which row-level security applies to.
DATABASE_URL=postgresql://erp_app:app_pw@localhost:5432/erp?schema=public

# Prisma Migrate connects as erp_owner, the table owner. Tenant tables force
# row-level security, so data migrations must set the tenant like the app does.
DATABASE_MIGRATE_URL=postgresql://erp_owner:owner_pw@localhost:5432/erp?schema=public

REDIS_URL=redis://localhost:6379

# Signs pagination cursors. At least 32 characters; use a real secret outside development.
APP_SECRET=development_secret_at_least_32_chars

# Signs access tokens. At least 32 characters and different from APP_SECRET.
JWT_SECRET=development_jwt_secret_at_least_32_chars

# Tenants log in at <slug>.<APP_BASE_DOMAIN>, e.g. demo.localhost:3000.
APP_BASE_DOMAIN=localhost

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Prefix for every queue key in Redis: lowercase letters, digits and dashes, up to 32.
QUEUE_PREFIX=erp

# Optional. Without it, errors are logged but not reported anywhere.
# SENTRY_DSN=

# Email. Locally this is Mailpit from docker-compose.yml; read what was sent at
# http://localhost:8025. In production, Resend's SMTP endpoint, e.g.
# smtps://resend:<api key>@smtp.resend.com:465
SMTP_URL=smtp://localhost:1025
# Sender when a tenant has not set its own (setting notification.sender).
MAIL_FROM=ERP <no-reply@example.test>

# Links in emails (invitations, password resets) point here; {tenant} becomes
# the tenant's slug.
WEB_URL_TEMPLATE=http://{tenant}.localhost:5173

# File storage, any S3-compatible service. Locally MinIO from docker-compose.yml
# (console at http://localhost:9001); in production Cloudflare R2, with
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and path style off.
# The bucket is private and created outside the application.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=erp-files
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_FORCE_PATH_STYLE=true
# Optional: the address clients use for signed links, when it differs from
# S3_ENDPOINT (docker-compose.yml sets it for the containerised API).
# S3_PUBLIC_ENDPOINT=
# Largest upload accepted, in bytes (default 100 MiB).
# FILE_MAX_BYTES=104857600
